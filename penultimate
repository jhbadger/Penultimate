    def animate(self):
        """Flip every animated square to its other frame, twice a second."""
        self.frame ^= 1
        if self.cells and not self.overlay:
            c = self.canvas
            for idx, (base, top) in enumerate(self.shown):
                nb, nt = self.framed(base), self.framed(top)
                if (nb, nt) == (base, top):
                    continue
                self.shown[idx] = (nb, nt)
                bid, tid = self.cells[idx]
                if nb != base:
                    c.itemconfig(bid, image=self.img[nb])
                if nt != top:
                    c.itemconfig(tid, image=self.img[nt])
        self.root.after(450, self.animate)

    def framed(self, name):
        """The current animation frame of a tile name (None and remembered
        "~" squares stay as they are)."""
        if not name or name[0] == "~":
            return name
        root = name[:-2] if name.endswith("@1") else name
        return root + "@1" if self.frame and root in self.animated else root

    def music_tick(self):
        self.sound.tick()
        self.root.after(100, self.music_tick)

    # ── Images ──

    def load_images(self):
        """16px tiles from TILE_PNG, plus darkened copies of the terrain (for
        remembered dungeon squares) and an average colour for the map."""
        self.base, self.dark, self.avg = {}, {}, {}
        for name, data in TILE_PNG.items():
            img = tk.PhotoImage(data="".join(data))
            self.base[name] = img
            if name.split("@")[0] in SPRITES:
                continue
            rows, tot = [], [0, 0, 0]
            for y in range(16):
                row = []
                for x in range(16):
                    c = img.get(x, y)
                    if isinstance(c, str):
                        c = tuple(int(v) for v in c.split())
                    for i in range(3):
                        tot[i] += c[i]
                    row.append("#%02x%02x%02x" % tuple(int(v * 0.38)
                                                       for v in c[:3]))
                rows.append("{" + " ".join(row) + "}")
            dark = tk.PhotoImage(width=16, height=16)
            dark.put(" ".join(rows))
            self.dark[name] = dark
            self.avg[name] = "#%02x%02x%02x" % tuple(v // 256 for v in tot)
        self.scale_images()

    def scale_images(self):
        s = self.scale
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.animated = {n for n in self.img if n + "@1" in self.img}
        self.dimg = {n: i.zoom(s) for n, i in self.dark.items()}

