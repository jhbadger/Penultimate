def cap(s):
    return s[:1].upper() + s[1:]


def compass(dx, dy):
    ang = math.degrees(math.atan2(-dy, dx)) % 360
    return ("east", "north-east", "north", "north-west", "west",
            "south-west", "south", "south-east")[int((ang + 22.5) // 45) % 8]


def where(frm, to):
    """'about 5 leagues to the north-east'"""
    dx, dy = to[0] - frm[0], to[1] - frm[1]
    if abs(dx) + abs(dy) <= 3:
        return "close by"
    lg = max(1, round(math.hypot(dx, dy) / 3))
    return "about %d league%s to the %s" % (lg, "s" if lg > 1 else "",
                                            compass(dx, dy))


# ── World generation ─────────────────────────────────────────────────────────
#
# Everything about a world is derived from its seed, so a saved game only
# has to remember the seed plus what the player has done.

WORLD_W = WORLD_H = 64


def smooth_noise(rng, w, h, cell):
    gw, gh = w // cell + 2, h // cell + 2
    pts = [[rng.random() for _ in range(gw)] for _ in range(gh)]
    out = []
    for y in range(h):
        gy = y / cell
        y0 = int(gy)
        ty = gy - y0
        ty = ty * ty * (3 - 2 * ty)
        row = []
        for x in range(w):
            gx = x / cell
            x0 = int(gx)
            tx = gx - x0
            tx = tx * tx * (3 - 2 * tx)
            a = pts[y0][x0] + (pts[y0][x0 + 1] - pts[y0][x0]) * tx
            b = pts[y0 + 1][x0] + (pts[y0 + 1][x0 + 1] - pts[y0 + 1][x0]) * tx
            row.append(a + (b - a) * ty)
        out.append(row)
    return out


def fractal(rng, w, h):
    layers = [(smooth_noise(rng, w, h, c), wt)
              for c, wt in ((16, 0.5), (8, 0.3), (4, 0.2))]
    return [[sum(l[y][x] * wt for l, wt in layers) for x in range(w)]
            for y in range(h)]


def terrain_at(e, m):
    if e < 0.30:
        return "deep"
    if e < 0.36:
        return "water"
    if e < 0.39:
        return "sand"
    if e > 0.68:
        return "mountain"
    if e > 0.61:
        return "hills"
    if m > 0.56:
        return "forest"
    if m < 0.40 and e < 0.50:
        return "swamp"
    return "grass"


def flood(grid, start, passable):
    """Breadth-first distances over passable tiles from start."""
    dist = {start: 0}
    q = deque([start])
    while q:
        x, y = q.popleft()
        for dx, dy in DIRS:
            n = (x + dx, y + dy)
            if (n not in dist and 0 <= n[0] < WORLD_W and 0 <= n[1] < WORLD_H
                    and grid[n[1]][n[0]] in passable):
                dist[n] = dist[(x, y)] + 1
                q.append(n)
    return dist


def generate_world(seed):
    for attempt in range(100):
        world = try_world(seed, attempt)
        if world:
            return world
    raise RuntimeError("could not generate a world")


def try_world(seed, attempt):
    rng = random.Random("%s:world:%d" % (seed, attempt))
    elev = fractal(rng, WORLD_W, WORLD_H)
    moist = fractal(rng, WORLD_W, WORLD_H)
    grid = []
    for y in range(WORLD_H):
        row = []
        for x in range(WORLD_W):
            nx, ny = 2 * x / (WORLD_W - 1) - 1, 2 * y / (WORLD_H - 1) - 1
            e = elev[y][x] + 0.14 - 0.5 * (nx * nx + ny * ny)
            row.append(terrain_at(e, moist[y][x]))
        grid.append(row)

    # The largest stretch of connected land is where everything goes
    seen, best = set(), set()
    for y in range(WORLD_H):
        for x in range(WORLD_W):
            if grid[y][x] in LAND and (x, y) not in seen:
                comp = set(flood(grid, (x, y), LAND))
                seen |= comp
                if len(comp) > len(best):
                    best = comp
    if len(best) < 1100:
        return None

    cx = sum(p[0] for p in best) / len(best)
    cy = sum(p[1] for p in best) / len(best)
    inner = [p for p in best
             if all((p[0] + dx, p[1] + dy) in best for dx, dy in DIRS)]
    castle = min(inner, key=lambda p: (p[0] - cx) ** 2 + (p[1] - cy) ** 2)
    dist = flood(grid, castle, LAND)
    land = sorted(best)
    rng.shuffle(land)
    taken = [castle]

    def pick(n, spacing, pool):
        out = []
        for p in pool:
            if all(abs(p[0] - q[0]) + abs(p[1] - q[1]) >= spacing
                   for q in taken + out):
                out.append(p)
                if len(out) == n:
                    break
        taken.extend(out)
        return out

    towns = pick(5, 11, land)
    far = sorted(land, key=lambda p: -dist.get(p, 0))
    lair = pick(1, 9, far[:len(far) // 8])
    dungeons = pick(5, 9, land)
    if len(towns) < 5 or len(dungeons) < 5 or not lair:
        return None
    dungeons.sort(key=lambda p: dist.get(p, 0))

    realm = rng.choice(REALMS)
    town_names = set()
    while len(town_names) < 5:
        town_names.add(rng.choice(TOWN_PRE) + rng.choice(TOWN_SUF))
    town_names = sorted(town_names)
    rng.shuffle(town_names)
    dnames = rng.sample(DUNGEON_NAMES, 5)
    artifacts = rng.sample(ARTIFACTS, 4)
    boss_names = rng.sample(BOSS_NAMES, 4)

    grid[castle[1]][castle[0]] = "castle"
    sites = {castle: ("castle", 0)}
    world = {"seed": seed, "realm": realm, "grid": grid, "castle": castle,
             "towns": [], "dungeons": [], "quests": [], "sites": sites}
    for i, (x, y) in enumerate(towns):
        grid[y][x] = "town"
        sites[(x, y)] = ("town", i)
        world["towns"].append({"name": town_names[i], "x": x, "y": y})
    # Nearest dungeons hold the easiest quests; the middle one is optional
    tiers = (1, 2, 2, 3, 4)
    quest_of = {0: 0, 1: 1, 3: 2, 4: 3}
    for i, (x, y) in enumerate(dungeons):
        grid[y][x] = "dungeon"
        sites[(x, y)] = ("dungeon", i)
        d = {"name": dnames[i], "x": x, "y": y, "tier": tiers[i],
             "levels": (2, 3, 3, 3, 4)[i], "quest": quest_of.get(i),
             "lair": False, "boss": None, "boss_type": None,
             "artifact": None}
        q = d["quest"]
        if q is not None:
            kind = rng.choice(BOSS_TYPES[q])
            d["boss_type"] = kind
            d["boss"] = "%s %s" % (boss_names[q], BOSS_TITLES[kind])
            d["artifact"] = artifacts[q]
            world["quests"].append(i)
        world["dungeons"].append(d)
    x, y = lair[0]
    grid[y][x] = "lair"
    sites[(x, y)] = ("dungeon", 5)
    world["dungeons"].append({
        "name": "Moosedain's Lair", "x": x, "y": y, "tier": 5, "levels": 4,
        "quest": None, "lair": True, "boss": "Moosedain the Wicked",
        "boss_type": "moosedain", "artifact": None})
    return world


# ── Maps and creatures ───────────────────────────────────────────────────────

class Area:
    """One map: the overworld, a town, the castle or a dungeon level."""

    def __init__(self, kind, key, grid, name, edge):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.edge = edge            # tile shown beyond the map edge, or None
        self.h, self.w = len(grid), len(grid[0])
        self.mobs = []
        self.start = (0, 0)
        self.down = None            # dungeon: the stairs down
        self.dark = False           # limited light, remembered tiles
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    """A creature on a map: a monster, or a person to talk to."""

    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.hostile = False
        self.kind = None
        self.hp = self.maxhp = 1
        self.dmg, self.defense, self.level, self.xp = (1, 2), 0, 1, 0
        self.traits = ""
        self.boss = False
        self.dungeon = None         # boss: index of its dungeon
        self.roam = None            # person: tiles they wander (None: stay)
        self.title = ""             # person: "the farmer" until NAME asked
        self.known = False
        self.talk = {}
        self.shop = None
        self.lord = False
        self.greet = ""


def make_monster(kind, x, y):
    t = MONSTERS[kind]
    m = Mob(t.tile, t.name, x, y)
    m.hostile, m.kind = True, kind
    m.hp = m.maxhp = t.hp
    m.dmg, m.defense, m.level, m.xp = t.dmg, t.defense, t.tier, t.xp
    m.traits = t.traits
    return m


def make_boss(d, di, x, y):
    m = make_monster(d["boss_type"], x, y)
    if not d["lair"]:
        m.hp = m.maxhp = m.hp * 3
        m.dmg = (m.dmg[0] + 2, m.dmg[1] + m.dmg[1] // 2)
        m.defense += 2
        m.level += 1
        m.xp *= 5
    m.name, m.boss, m.dungeon = d["boss"], True, di
    return m


def person(tile, title, name, x, y, talk, roam=None):
    m = Mob(tile, name, x, y)
    m.title, m.roam = title, roam
    m.talk = {"name": "My name is %s." % name, "health": random.choice(HEALTH)}
    m.talk.update(talk)
    m.greet = random.choice(GREETINGS)
    return m


def town_rumours(world, here):
    out = list(TIPS)
    for d in world["dungeons"]:
        spot = (d["x"], d["y"])
        if d["lair"]:
            out.append("Moosedain's lair lies %s, sealed by enchanted ice."
                       % where(here, spot))
            continue
        out.append("They say %s lies %s." % (d["name"], where(here, spot)))
        if d["boss"]:
            out.append("%s lurks in the depths of %s, guarding %s."
                       % (d["boss"], d["name"], d["artifact"]))
    out.append("Lord Canadian's castle lies %s." % where(here, world["castle"]))
    for t in world["towns"]:
        if (t["x"], t["y"]) != here:
            out.append("The town of %s lies %s."
                       % (t["name"], where(here, (t["x"], t["y"]))))
    return out


def townsfolk(rng, world, here, x, y, roam):
    """A random townsperson with a job, a hobby-horse and a rumour."""
    job, kw, job_line, reply = rng.choice(JOBS)
    rumours = town_rumours(world, here)
    if reply == "%D":
        d = rng.choice(world["dungeons"][:5])
        reply = "%s lies %s. Bring torches... oh, and a sword." % (
            cap(d["name"]), where(here, (d["x"], d["y"])))
    news = rng.choice(rumours)
    name = rng.choice(FIRST_NAMES)
    tile = rng.choice(("man", "woman"))
    m = person(tile, "the " + job, name, x, y,
               {"job": job_line + " Ask me for NEWS, if thou likest.",
                kw: reply, "news": news, "rumour": news, "rumor": news},
               roam)
    m.talk["health"] = rng.choice(HEALTH)
    m.greet = rng.choice(GREETINGS)
    return m


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def frame(g, x0, y0, x1, y1, tile):
    for x in range(x0, x1 + 1):
        g[y0][x] = g[y1][x] = tile
    for y in range(y0, y1 + 1):
        g[y][x0] = g[y][x1] = tile


def fill(g, x0, y0, x1, y1, tile):
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = tile


SHOP_KINDS = ["weapon", "armor", "healer", "inn", "tavern"]
SHOP_TITLES = {"weapon": "the blacksmith", "armor": "the armourer",
               "healer": "the healer", "inn": "the innkeeper",
               "tavern": "the barkeep", "quartermaster": "the quartermaster"}


def make_town(world, ti):
    t = world["towns"][ti]
    here = (t["x"], t["y"])
    rng = random.Random("%s:town:%d" % (world["seed"], ti))
    W, H, mx, my = 34, 26, 16, 12
    g = blank(W, H, "grass")
    frame(g, 1, 1, W - 2, H - 2, "brick")
    for y in range(H):                       # streets (and gates)
        g[y][mx] = g[y][mx + 1] = "cobble"
    for x in range(W):
        g[my][x] = g[my + 1][x] = "cobble"
    g[my][mx] = "fountain"
    area = Area("town", ("town", ti), g, "the town of " + t["name"], "grass")
    area.start = (mx, H - 1)

    slots = [(sx, top) for sx in (2, 9, 18, 25) for top in (True, False)]
    rng.shuffle(slots)
    kinds = SHOP_KINDS + ["house", "house"]
    for kind, (sx, top) in zip(kinds, slots):
        bw, bh = 6, rng.randint(5, 7)
        bx = sx + rng.randint(0, 1)
        by = my - 1 - bh if top else my + 3
        frame(g, bx, by, bx + bw - 1, by + bh - 1, "brick")
        fill(g, bx + 1, by + 1, bx + bw - 2, by + bh - 2, "wood")
        dx = bx + rng.randint(1, bw - 2)
        dy = by + bh - 1 if top else by
        out = dy + 1 if top else dy - 1
        g[dy][dx] = "door"
        g[out][dx] = "cobble"
        if kind == "house":
            name = rng.choice(FIRST_NAMES)
            job, kw, job_line, reply = rng.choice(JOBS[:5] + JOBS[6:])
            news = rng.choice(town_rumours(world, here))
            area.mobs.append(person(
                rng.choice(("man", "woman")), "the " + job, name,
                bx + 2, by + 2,
                {"job": job_line + " Ask me for NEWS.", kw: reply,
                 "news": news, "rumour": news, "rumor": news},
                roam={"wood"}))
            continue
        g[out][dx + 1] = "sign_" + kind
        keeper_y = by + 1 if top else by + bh - 2
        counter_y = keeper_y + 1 if top else keeper_y - 1
        fill(g, bx + 1, counter_y, bx + bw - 2, counter_y, "counter")
        area.mobs.append(shopkeeper(rng, world, kind, bx + bw // 2,
                                    keeper_y, here))

    # trees on open grass, away from the streets
    for _ in range(60):
        x, y = rng.randint(2, W - 3), rng.randint(2, H - 3)
        if g[y][x] == "grass" and all(
                g[y + dy][x + dx] in ("grass", "forest", "brick")
                for dx, dy in DIRS):
            g[y][x] = "forest"

    def free_spot(tiles):
        while True:
            x, y = rng.randint(2, W - 3), rng.randint(2, H - 3)
            if g[y][x] in tiles and not area.mob_at(x, y):
                return x, y

    for gx, gy in ((mx - 1, H - 3), (mx + 2, 2)):
        g[gy][gx] = "grass"
        name = rng.choice(FIRST_NAMES)
        area.mobs.append(person(
            "guard", "the Mountie", "Constable " + name, gx, gy,
            {"job": "I keep the peace in %s. We always get our MONSTER."
             % t["name"],
             "monster": "Monsters grow fiercer the farther thou travellest "
             "from Lord Canadian's castle. Start close to home.",
             "news": rng.choice(town_rumours(world, here))}))
    for _ in range(6):
        x, y = free_spot(("grass", "cobble"))
        area.mobs.append(townsfolk(rng, world, here, x, y,
                                   {"grass", "cobble"}))
    return area


def shopkeeper(rng, world, kind, x, y, here):
    name = rng.choice(FIRST_NAMES)
    shop = {"kind": kind}
    if kind == "weapon":
        shop["title"] = "%s's Smithy" % name
        shop["stock"] = sorted(rng.sample(SHOP_WEAPONS, 4),
                               key=lambda n: WEAPONS[n].price)
        job = "I forge and sell weapons."
    elif kind == "armor":
        shop["title"] = "%s's Armoury" % name
        shop["stock"] = sorted(rng.sample(SHOP_ARMOURS, 3),
                               key=lambda n: ARMOURS[n].price)
        job = "I sell armour, to keep the monsters' teeth out of thee."
    elif kind == "healer":
        shop["title"] = "the House of Healing"
        job = "I heal wounds and cure poison, and I sell potions."
    elif kind == "inn":
        shop["title"] = "the %s %s Inn" % (
            rng.choice(("Sleepy", "Frozen", "Snoring", "Drowsy", "Cozy")),
            rng.choice(("Moose", "Goose", "Beaver", "Loon", "Caribou")))
        job = "I keep the inn. A night's rest heals all wounds."
    else:
        shop["title"] = "the %s %s" % (
            rng.choice(("Tipsy", "Jolly", "Thirsty", "Rowdy", "Polite")),
            rng.choice(("Loon", "Moose", "Puck", "Canoe", "Toque")))
        job = "I run the tavern. Food for the road, and ale for gossip."
    news = rng.choice(town_rumours(world, here))
    m = person("woman" if kind == "healer" else "merchant", SHOP_TITLES[kind],
               name, x, y, {"job": job + " Wouldst thou BUY something?",
                            "news": news, "rumour": news, "rumor": news})
    m.shop = shop
    m.greet = "Welcome to %s! Wouldst thou BUY something?" % shop["title"]
    return m


def make_castle(world):
