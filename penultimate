def cap(s):
    return s[:1].upper() + s[1:]


def compass(dx, dy):
    ang = math.degrees(math.atan2(-dy, dx)) % 360
    return ("east", "north-east", "north", "north-west", "west",
            "south-west", "south", "south-east")[int((ang + 22.5) // 45) % 8]


def where(frm, to):
    """'about 5 leagues to the north-east'"""
    dx, dy = to[0] - frm[0], to[1] - frm[1]
    if abs(dx) + abs(dy) <= 3:
        return "close by"
    lg = max(1, round(math.hypot(dx, dy) / 3))
    return "about %d league%s to the %s" % (lg, "s" if lg > 1 else "",
                                            compass(dx, dy))


# ── World generation ─────────────────────────────────────────────────────────
#
# Everything about a world is derived from its seed, so a saved game only
# has to remember the seed plus what the player has done.

WORLD_W = WORLD_H = 64


def smooth_noise(rng, w, h, cell):
    gw, gh = w // cell + 2, h // cell + 2
    pts = [[rng.random() for _ in range(gw)] for _ in range(gh)]
    out = []
    for y in range(h):
        gy = y / cell
        y0 = int(gy)
        ty = gy - y0
        ty = ty * ty * (3 - 2 * ty)
        row = []
        for x in range(w):
            gx = x / cell
            x0 = int(gx)
            tx = gx - x0
            tx = tx * tx * (3 - 2 * tx)
            a = pts[y0][x0] + (pts[y0][x0 + 1] - pts[y0][x0]) * tx
            b = pts[y0 + 1][x0] + (pts[y0 + 1][x0 + 1] - pts[y0 + 1][x0]) * tx
            row.append(a + (b - a) * ty)
        out.append(row)
    return out


def fractal(rng, w, h):
    layers = [(smooth_noise(rng, w, h, c), wt)
              for c, wt in ((16, 0.5), (8, 0.3), (4, 0.2))]
    return [[sum(l[y][x] * wt for l, wt in layers) for x in range(w)]
            for y in range(h)]


def terrain_at(e, m):
    if e < 0.30:
        return "deep"
    if e < 0.36:
        return "water"
    if e < 0.39:
        return "sand"
    if e > 0.68:
        return "mountain"
    if e > 0.61:
        return "hills"
    if m > 0.56:
        return "forest"
    if m < 0.40 and e < 0.50:
        return "swamp"
    return "grass"


def flood(grid, start, passable):
    """Breadth-first distances over passable tiles from start."""
    dist = {start: 0}
    q = deque([start])
    while q:
        x, y = q.popleft()
        for dx, dy in DIRS:
            n = (x + dx, y + dy)
            if (n not in dist and 0 <= n[0] < WORLD_W and 0 <= n[1] < WORLD_H
                    and grid[n[1]][n[0]] in passable):
                dist[n] = dist[(x, y)] + 1
                q.append(n)
    return dist


def generate_world(seed):
    for attempt in range(100):
        world = try_world(seed, attempt)
        if world:
            return world
    raise RuntimeError("could not generate a world")


def try_world(seed, attempt):
    rng = random.Random("%s:world:%d" % (seed, attempt))
    elev = fractal(rng, WORLD_W, WORLD_H)
    moist = fractal(rng, WORLD_W, WORLD_H)
    grid = []
    for y in range(WORLD_H):
        row = []
        for x in range(WORLD_W):
            nx, ny = 2 * x / (WORLD_W - 1) - 1, 2 * y / (WORLD_H - 1) - 1
            e = elev[y][x] + 0.14 - 0.5 * (nx * nx + ny * ny)
            row.append(terrain_at(e, moist[y][x]))
        grid.append(row)

    # The largest stretch of connected land is where everything goes
    seen, best = set(), set()
    for y in range(WORLD_H):
        for x in range(WORLD_W):
            if grid[y][x] in LAND and (x, y) not in seen:
                comp = set(flood(grid, (x, y), LAND))
                seen |= comp
                if len(comp) > len(best):
                    best = comp
    if len(best) < 1100:
        return None

    cx = sum(p[0] for p in best) / len(best)
    cy = sum(p[1] for p in best) / len(best)
    inner = [p for p in best
             if all((p[0] + dx, p[1] + dy) in best for dx, dy in DIRS)]
    castle = min(inner, key=lambda p: (p[0] - cx) ** 2 + (p[1] - cy) ** 2)
    dist = flood(grid, castle, LAND)
    land = sorted(best)
    rng.shuffle(land)
    taken = [castle]

    def pick(n, spacing, pool):
        out = []
        for p in pool:
            if all(abs(p[0] - q[0]) + abs(p[1] - q[1]) >= spacing
                   for q in taken + out):
                out.append(p)
                if len(out) == n:
                    break
        taken.extend(out)
        return out

    towns = pick(5, 11, land)
    far = sorted(land, key=lambda p: -dist.get(p, 0))
    lair = pick(1, 9, far[:len(far) // 8])
    dungeons = pick(5, 9, land)
    if len(towns) < 5 or len(dungeons) < 5 or not lair:
        return None
    dungeons.sort(key=lambda p: dist.get(p, 0))

    realm = rng.choice(REALMS)
    town_names = set()
    while len(town_names) < 5:
        town_names.add(rng.choice(TOWN_PRE) + rng.choice(TOWN_SUF))
    town_names = sorted(town_names)
    rng.shuffle(town_names)
    dnames = rng.sample(DUNGEON_NAMES, 5)
    artifacts = rng.sample(ARTIFACTS, 4)
    boss_names = rng.sample(BOSS_NAMES, 4)

    grid[castle[1]][castle[0]] = "castle"
    sites = {castle: ("castle", 0)}
    world = {"seed": seed, "realm": realm, "grid": grid, "castle": castle,
             "towns": [], "dungeons": [], "quests": [], "sites": sites}
    for i, (x, y) in enumerate(towns):
        grid[y][x] = "town"
        sites[(x, y)] = ("town", i)
        world["towns"].append({"name": town_names[i], "x": x, "y": y})
    # Nearest dungeons hold the easiest quests; the middle one is optional
    tiers = (1, 2, 2, 3, 4)
    quest_of = {0: 0, 1: 1, 3: 2, 4: 3}
    for i, (x, y) in enumerate(dungeons):
        grid[y][x] = "dungeon"
        sites[(x, y)] = ("dungeon", i)
        d = {"name": dnames[i], "x": x, "y": y, "tier": tiers[i],
             "levels": (2, 3, 3, 3, 4)[i], "quest": quest_of.get(i),
             "lair": False, "boss": None, "boss_type": None,
             "artifact": None}
        q = d["quest"]
        if q is not None:
            kind = rng.choice(BOSS_TYPES[q])
            d["boss_type"] = kind
            d["boss"] = "%s %s" % (boss_names[q], BOSS_TITLES[kind])
            d["artifact"] = artifacts[q]
            world["quests"].append(i)
        world["dungeons"].append(d)
    x, y = lair[0]
    grid[y][x] = "lair"
    sites[(x, y)] = ("dungeon", 5)
    world["dungeons"].append({
        "name": "Moosedain's Lair", "x": x, "y": y, "tier": 5, "levels": 4,
        "quest": None, "lair": True, "boss": "Moosedain the Wicked",
        "boss_type": "moosedain", "artifact": None})
    return world


def place_inukshuks(world):
    """Put an inukshuk on up to five islands: land cut off from the mainland
    by water, reachable only by canoe.  Worlds with fewer than three
    islands get small new ones raised in open water near the coast."""
    grid = world["grid"]
    rng = random.Random("%s:islands" % world["seed"])
    seen = set(flood(grid, world["castle"],
                     LAND | {"town", "castle", "dungeon", "lair"}))
    spots = []
    for y in range(WORLD_H):
        for x in range(WORLD_W):
            if grid[y][x] not in LAND or (x, y) in seen:
                continue
            comp = sorted(flood(grid, (x, y), LAND))
            seen.update(comp)
            if any(0 <= cx + dx < WORLD_W and 0 <= cy + dy < WORLD_H and
                   grid[cy + dy][cx + dx] in WATER
                   for cx, cy in comp for dx, dy in DIRS):
                spots.append(rng.choice(comp))
    rng.shuffle(spots)
    spots = spots[:5]
    if len(spots) < 3:
        # distance from land, for every square
        near = {(x, y): 0 for y in range(WORLD_H) for x in range(WORLD_W)
                if grid[y][x] not in WATER}
        q = deque(near)
        while q:
            x, y = q.popleft()
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if (n not in near and 0 <= n[0] < WORLD_W
                        and 0 <= n[1] < WORLD_H):
                    near[n] = near[(x, y)] + 1
                    q.append(n)
        sea = [p for p, d in sorted(near.items()) if 4 <= d <= 7
               and 3 <= p[0] < WORLD_W - 3 and 3 <= p[1] < WORLD_H - 3]
        rng.shuffle(sea)
        for x, y in sea:
            if len(spots) >= 3:
                break
            if any(abs(x - a) + abs(y - b) < 10 for a, b in spots):
                continue
            for dx, dy in rng.sample(DIRS, rng.randint(2, 4)):
                grid[y + dy][x + dx] = "sand"
            grid[y][x] = "grass"
            spots.append((x, y))
    world["inukshuks"] = spots
    for x, y in world["inukshuks"]:
        grid[y][x] = "inukshuk"


# ── Side quests ──────────────────────────────────────────────────────────────
#
# Two errands per town, chosen from the seed like everything else: slay
# some monsters, fetch something from a dungeon, catch a runaway goose, or
# carry a parcel to a shopkeeper in another town.

SIDE_ITEMS = ["a grandfather's pocket watch", "the town's lucky curling stone",
              "a wedding ring", "a jar of grandmother's maple fudge",
              "a lucky toque", "the chapel bell's clapper",
              "a book of terrible poems", "a prize-winning pie dish"]
DELIVERIES = ["a crate of maple syrup", "a love letter", "a parcel of poutine",
              "a hockey stick for a nephew", "a wheel of cheese curds",
              "a box of apology cards", "a very polite complaint"]
GOOSE_NAMES = ["Honker", "Gertrude", "Admiral Flap", "Mabel",
               "Sir Hisses-a-Lot", "Duchess", "Pickles"]
ERRAND_WORDS = ("help", "ques", "work", "task", "erra", "chor")


def plural(name):
    if name.endswith("f"):
        return name[:-1] + "ves"
    return name + ("es" if name.endswith("ch") else "s")


def make_side_quests(world):
    rng = random.Random("%s:side" % world["seed"])
    grid = world["grid"]
    cx, cy = world["castle"]
    mainland = set(flood(grid, world["castle"],
                         LAND | {"town", "castle", "dungeon", "lair"}))
    used = set()                     # (town, shop) parcels go to
    out = []

    def hunt(q, here):
        danger = max(1, min(6, 1 + int(math.hypot(here[0] - cx,
                                                  here[1] - cy) // 8)))
        kinds = [k for k, m in MONSTERS.items()
                 if m.habitat in ("world", "both", "forest")
                 and danger - 1 <= m.tier <= danger]
        q["monster"] = rng.choice(kinds)
        q["count"] = rng.randint(3, 6)
        tier = MONSTERS[q["monster"]].tier
        q["gold"] = 20 + 15 * q["count"] * tier
        q["xp"] = 10 * q["count"] * tier
        return True

    def fetch(q, here):
        di = rng.randrange(5)
        d = world["dungeons"][di]
        q.update(dungeon=di, level=rng.randint(1, d["levels"]),
                 item=rng.choice(SIDE_ITEMS))
        v = d["tier"] + q["level"]
        q["gold"], q["xp"] = 50 * v, 30 * v
        return True

    def goose(q, here):
        spots = [(x, y) for (x, y) in sorted(mainland)
                 if grid[y][x] in ("grass", "sand", "hills")
                 and 5 <= abs(x - here[0]) + abs(y - here[1]) <= 12]
        if not spots:
            return False
        q["home"] = rng.choice(spots)
        q["goose"] = rng.choice(GOOSE_NAMES)
        dist = abs(q["home"][0] - here[0]) + abs(q["home"][1] - here[1])
        q["gold"], q["xp"] = 40 + 3 * dist, 30
        return True

    def deliver(q, here):
        options = [(tj, sk) for tj in range(len(world["towns"]))
                   if tj != q["town"]
                   for sk in SHOP_KINDS + ["outfitter", "mage"]
                   if (tj, sk) not in used]
        tj, sk = rng.choice(options)
        used.add((tj, sk))
        t = world["towns"][tj]
        dist = math.hypot(t["x"] - here[0], t["y"] - here[1])
        q.update(to_town=tj, to_shop=sk, to=rng.choice(FIRST_NAMES),
                 item=rng.choice(DELIVERIES), gold=int(30 + 4 * dist),
                 xp=int(20 + 2 * dist))
        return True

    makers = {"hunt": hunt, "fetch": fetch, "goose": goose,
              "deliver": deliver}
    for ti, t in enumerate(world["towns"]):
        here = (t["x"], t["y"])
        kinds = rng.sample(sorted(makers), 4)
        slot = 0
        for kind in kinds:
            q = {"id": str(len(out)), "town": ti, "slot": slot, "kind": kind,
                 "giver": rng.choice(FIRST_NAMES)}
            if makers[kind](q, here):
                out.append(q)
                slot += 1
                if slot == 2:
                    break
    world["side"] = out


def errand_text(world, q):
    """What the quest giver asks of thee."""
    town = world["towns"][q["town"]]
    here = (town["x"], town["y"])
    if q["kind"] == "hunt":
        return ("%s have been troubling us. Slay %d of them and I'll pay "
                "thee %d gold." % (cap(plural(MONSTERS[q["monster"]].name)),
                                   q["count"], q["gold"]))
    if q["kind"] == "fetch":
        d = world["dungeons"][q["dungeon"]]
        return ("Goblins stole %s and carried it off to %s, %s of here. "
                "It'll be in a chest on level %d, I'll wager. Bring it back "
                "and I'll pay thee %d gold!" % (
                    q["item"], d["name"], where(here, (d["x"], d["y"])),
                    q["level"], q["gold"]))
    if q["kind"] == "goose":
        return ("My prize goose, %s, has run off! She was last seen %s of "
                "town. Catch her and bring her home, and I'll pay thee %d "
                "gold." % (q["goose"], where(here, q["home"]), q["gold"]))
    t = world["towns"][q["to_town"]]
    return ("Could thou take %s to %s, %s in %s? It lies %s of here. %s "
            "will pay thee %d gold for thy trouble." % (
                q["item"], q["to"], SHOP_TITLES[q["to_shop"]], t["name"],
                where(here, (t["x"], t["y"])), q["to"], q["gold"]))


# ── Maps and creatures ───────────────────────────────────────────────────────

class Area:
    """One map: the overworld, a town, the castle or a dungeon level."""

    def __init__(self, kind, key, grid, name, edge):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.edge = edge            # tile shown beyond the map edge, or None
        self.h, self.w = len(grid), len(grid[0])
        self.mobs = []
        self.start = (0, 0)
        self.down = None            # dungeon: the stairs down
        self.dark = False           # limited light, remembered tiles
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.skin = {}              # tile -> the tile drawn for it (themes)
        self.items = {}             # (x, y) -> "key" or a spotted "trap"
        self.traps = set()          # hidden traps
        self.keys = 0               # keys found on this dungeon level
        self.errand_chests = {}     # (x, y) -> id of the errand it is for

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    """A creature on a map: a monster, or a person to talk to."""

    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.hostile = False
        self.kind = None
        self.hp = self.maxhp = 1
        self.dmg, self.defense, self.level, self.xp = (1, 2), 0, 1, 0
        self.traits = ""
        self.boss = False
        self.dungeon = None         # boss: index of its dungeon
        self.roam = None            # person: tiles they wander (None: stay)
        self.title = ""             # person: "the farmer" until NAME asked
        self.known = False
        self.talk = {}
        self.shop = None
        self.lord = False
        self.greet = ""
        self.flee = 0               # monster: turns left running away
        self.quest = None           # person: id of the errand they offer
        self.recipient = None       # shopkeeper: id of a parcel for them
        self.goose = None           # a runaway goose: its errand's id
        self.home = None            # where a goose stays near


def make_monster(kind, x, y):
    t = MONSTERS[kind]
    m = Mob(t.tile, t.name, x, y)
    m.hostile, m.kind = True, kind
    m.hp = m.maxhp = t.hp
    m.dmg, m.defense, m.level, m.xp = t.dmg, t.defense, t.tier, t.xp
    m.traits = t.traits
    return m


BOSS_HP = (2.5, 3.5, 3.5, 2.5)        # by quest: the middle two need more


def make_boss(d, di, x, y):
    m = make_monster(d["boss_type"], x, y)
    if not d["lair"]:
        # tuned with a fight simulator: a boss should cost about a full
        # health bar (so a potion or two) for a player at the expected level
        m.hp = m.maxhp = int(m.hp * BOSS_HP[d["quest"] or 0])
        m.dmg = (m.dmg[0] + 1, m.dmg[1] + m.dmg[1] // 4)
        m.defense += 1
        m.level += 1
        m.xp *= 5
    m.name, m.boss, m.dungeon = d["boss"], True, di
    return m


def person(tile, title, name, x, y, talk, roam=None):
    m = Mob(tile, name, x, y)
    m.title, m.roam = title, roam
    m.talk = {"name": "My name is %s." % name, "health": random.choice(HEALTH)}
    m.talk.update(talk)
    m.greet = random.choice(GREETINGS)
    return m


def town_rumours(world, here):
    out = list(TIPS)
    for d in world["dungeons"]:
        spot = (d["x"], d["y"])
        if d["lair"]:
            out.append("Moosedain's lair lies %s, sealed by enchanted ice."
                       % where(here, spot))
            continue
        out.append("They say %s lies %s." % (d["name"], where(here, spot)))
        if d["boss"]:
            out.append("%s lurks in the depths of %s, guarding %s."
                       % (d["boss"], d["name"], d["artifact"]))
    out.append("Lord Canadian's castle lies %s." % where(here, world["castle"]))
    for x, y in world.get("inukshuks", []):
        out.append("An inukshuk stands on an island %s. Travellers leave "
                   "gifts beneath them, they say. Thou'lt need a canoe."
                   % where(here, (x, y)))
    for t in world["towns"]:
        if (t["x"], t["y"]) != here:
            out.append("The town of %s lies %s."
                       % (t["name"], where(here, (t["x"], t["y"]))))
    return out


def townsfolk(rng, world, here, x, y, roam):
    """A random townsperson with a job, a hobby-horse and a rumour."""
    job, kw, job_line, reply = rng.choice(JOBS)
    rumours = town_rumours(world, here)
    if reply == "%D":
        d = rng.choice(world["dungeons"][:5])
        reply = "%s lies %s. Bring torches... oh, and a sword." % (
            cap(d["name"]), where(here, (d["x"], d["y"])))
    news = rng.choice(rumours)
    name = rng.choice(FIRST_NAMES)
    tile = rng.choice(("man", "woman"))
    m = person(tile, "the " + job, name, x, y,
               {"job": job_line + " Ask me for NEWS, if thou likest.",
                kw: reply, "news": news, "rumour": news, "rumor": news},
               roam)
    m.talk["health"] = rng.choice(HEALTH)
    m.greet = rng.choice(GREETINGS)
    return m


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def frame(g, x0, y0, x1, y1, tile):
    for x in range(x0, x1 + 1):
        g[y0][x] = g[y1][x] = tile
    for y in range(y0, y1 + 1):
        g[y][x0] = g[y][x1] = tile


def fill(g, x0, y0, x1, y1, tile):
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = tile


SHOP_KINDS = ["weapon", "armor", "healer", "inn", "tavern"]
SHOP_TITLES = {"outfitter": "the outfitter", "mage": "the mage",
               "weapon": "the blacksmith", "armor": "the armourer",
               "healer": "the healer", "inn": "the innkeeper",
               "tavern": "the barkeep", "quartermaster": "the quartermaster"}


def make_town(world, ti):
    t = world["towns"][ti]
    here = (t["x"], t["y"])
    rng = random.Random("%s:town:%d" % (world["seed"], ti))
    W, H, mx, my = 34, 26, 16, 12
    g = blank(W, H, "grass")
    frame(g, 1, 1, W - 2, H - 2, "brick")
    for y in range(H):                       # streets (and gates)
        g[y][mx] = g[y][mx + 1] = "cobble"
    for x in range(W):
        g[my][x] = g[my + 1][x] = "cobble"
    g[my][mx] = "fountain"
    area = Area("town", ("town", ti), g, "the town of " + t["name"], "grass")
    area.start = (mx, H - 1)

    slots = [(sx, top) for sx in (2, 9, 18, 25) for top in (True, False)]
    rng.shuffle(slots)
    kinds = SHOP_KINDS + ["outfitter", "mage", "house"]
    for kind, (sx, top) in zip(kinds, slots):
        bw, bh = 6, rng.randint(5, 7)
        bx = sx + rng.randint(0, 1)
        by = my - 1 - bh if top else my + 3
        frame(g, bx, by, bx + bw - 1, by + bh - 1, "brick")
        fill(g, bx + 1, by + 1, bx + bw - 2, by + bh - 2, "wood")
        dx = bx + rng.randint(1, bw - 2)
        dy = by + bh - 1 if top else by
        out = dy + 1 if top else dy - 1
        g[dy][dx] = "door"
        g[out][dx] = "cobble"
        if kind == "house":
            name = rng.choice(FIRST_NAMES)
            job, kw, job_line, reply = rng.choice(JOBS[:5] + JOBS[6:])
            news = rng.choice(town_rumours(world, here))
            area.mobs.append(person(
                rng.choice(("man", "woman")), "the " + job, name,
                bx + 2, by + 2,
                {"job": job_line + " Ask me for NEWS.", kw: reply,
                 "news": news, "rumour": news, "rumor": news},
                roam={"wood"}))
            continue
        g[out][dx + 1] = "sign_" + kind
        keeper_y = by + 1 if top else by + bh - 2
        counter_y = keeper_y + 1 if top else keeper_y - 1
        fill(g, bx + 1, counter_y, bx + bw - 2, counter_y, "counter")
        area.mobs.append(shopkeeper(rng, world, kind, bx + bw // 2,
                                    keeper_y, here))

    # trees on open grass, away from the streets
    for _ in range(60):
        x, y = rng.randint(2, W - 3), rng.randint(2, H - 3)
        if g[y][x] == "grass" and all(
                g[y + dy][x + dx] in ("grass", "forest", "brick")
                for dx, dy in DIRS):
            g[y][x] = "forest"

    def free_spot(tiles):
        while True:
            x, y = rng.randint(2, W - 3), rng.randint(2, H - 3)
            if g[y][x] in tiles and not area.mob_at(x, y):
                return x, y

    for gx, gy in ((mx - 1, H - 3), (mx + 2, 2)):
        g[gy][gx] = "grass"
        name = rng.choice(FIRST_NAMES)
        area.mobs.append(person(
            "guard", "the Mountie", "Constable " + name, gx, gy,
            {"job": "I keep the peace in %s. We always get our MONSTER."
             % t["name"],
             "monster": "Monsters grow fiercer the farther thou travellest "
             "from Lord Canadian's castle. Start close to home.",
             "news": rng.choice(town_rumours(world, here))}))
    folks = []
    for _ in range(6):
        x, y = free_spot(("grass", "cobble"))
        folks.append(townsfolk(rng, world, here, x, y, {"grass", "cobble"}))
    area.mobs += folks
    for q in world.get("side", []):
        if q["town"] == ti:
            m = folks[q["slot"]]
            m.name, m.quest = q["giver"], q["id"]
            m.talk["name"] = "My name is %s." % q["giver"]
            m.talk["job"] += " And I could use some HELP, if thou art willing."
            m.greet = "Oh! Thou look'st like an adventurer. Couldst thou HELP me?"
        if q["kind"] == "deliver" and q["to_town"] == ti:
            m = next(k for k in area.mobs
                     if k.shop and k.shop["kind"] == q["to_shop"])
            m.name, m.recipient = q["to"], q["id"]
            m.talk["name"] = "My name is %s." % q["to"]
    return area


def shopkeeper(rng, world, kind, x, y, here):
    name = rng.choice(FIRST_NAMES)
    shop = {"kind": kind}
    if kind == "weapon":
        shop["title"] = "%s's Smithy" % name
        shop["stock"] = sorted(rng.sample(SHOP_WEAPONS, 4),
                               key=lambda n: WEAPONS[n].price)
        job = "I forge and sell weapons."
    elif kind == "armor":
        shop["title"] = "%s's Armoury" % name
        shop["stock"] = sorted(rng.sample(SHOP_ARMOURS, 3),
                               key=lambda n: ARMOURS[n].price)
        job = "I sell armour, to keep the monsters' teeth out of thee."
    elif kind == "healer":
        shop["title"] = "the House of Healing"
        job = "I heal wounds and cure poison, and I sell potions."
    elif kind == "inn":
        shop["title"] = "the %s %s Inn" % (
            rng.choice(("Sleepy", "Frozen", "Snoring", "Drowsy", "Cozy")),
            rng.choice(("Moose", "Goose", "Beaver", "Loon", "Caribou")))
        job = "I keep the inn. A night's rest heals all wounds."
    elif kind == "outfitter":
        shop["title"] = "%s's Outfitters" % name
        job = "I outfit travellers: canoes, slings, pucks and rations."
    elif kind == "mage":
        shop["title"] = "the %s Tower" % rng.choice((
            "Aurora", "Northern Lights", "Starry", "Frostfire", "Moonlit"))
        shop["stock"] = sorted(rng.sample(list(SPELLS), 4),
                               key=lambda n: SPELLS[n].price)
        job = "I study the arcane arts, and sell spellbooks to those with " \
              "the wit to read them."
    else:
        shop["title"] = "the %s %s" % (
            rng.choice(("Tipsy", "Jolly", "Thirsty", "Rowdy", "Polite")),
            rng.choice(("Loon", "Moose", "Puck", "Canoe", "Toque")))
        job = "I run the tavern. Food for the road, and ale for gossip."
    news = rng.choice(town_rumours(world, here))
    m = person({"healer": "woman", "mage": "wizard"}.get(kind, "merchant"),
               SHOP_TITLES[kind],
               name, x, y, {"job": job + " Wouldst thou BUY something?",
                            "news": news, "rumour": news, "rumor": news})
    m.shop = shop
    m.greet = "Welcome to %s! Wouldst thou BUY something?" % shop["title"]
    return m


def make_castle(world):
    rng = random.Random("%s:castle" % world["seed"])
    W, H, mx = 33, 27, 16
    g = blank(W, H, "grass")
    frame(g, 1, 1, W - 2, H - 2, "water")
    frame(g, 2, 2, W - 3, H - 3, "brick")
    frame(g, 9, 3, 23, 12, "brick")
    fill(g, 10, 4, 22, 11, "stone")
    for y in range(5, 12):
        g[y][mx] = "carpet"
    g[4][mx] = "throne"
    g[12][mx] = "door"
    for y in range(13, H):
        g[y][mx] = "cobble"
    for x in range(4, 30):
        g[19][x] = "cobble"
    g[17][8] = g[17][24] = "fountain"
    area = Area("castle", ("castle",), g, "Castle Canadian", "grass")
    area.start = (mx, H - 1)

    lord = person("lord", "Lord Canadian", "Lord Canadian", mx, 4, {})
    lord.lord = lord.known = True
    area.mobs.append(lord)
    for gx, gy in ((13, 6), (19, 6), (13, 9), (19, 9), (15, 23), (17, 23)):
        name = rng.choice(FIRST_NAMES)
        area.mobs.append(person(
            "guard", "the royal Mountie", "Sergeant " + name, gx, gy,
            {"job": "I guard His Lordship. Speak with him about thy QUEST.",
             "quest": "Lord Canadian sits upon his throne, at the end of "
             "the red carpet. Walk up and speak with him.",
             "news": rng.choice(TIPS)}))
    jester = person("jester", "the jester", "Pip", 11, 10,
                    {"job": "I am the royal fool. Wouldst thou hear a JOKE?",
                     "joke": " / ".join(rng.sample(JOKES, 2)),
                     "news": "Did thou knowest Lord Canadian once "
                     "apologised to a door for walking into it?"},
                    roam={"stone"})
    area.mobs.append(jester)
    doc = person("woman", "the royal physician", "Dame Agatha", 6, 20,
                 {"job": "I tend the royal household. Wouldst thou BUY "
                  "something?"})
    doc.shop = {"kind": "healer", "title": "the royal infirmary"}
    doc.greet = "Hurt, are we? Wouldst thou BUY something?"
    qm = person("merchant", "the quartermaster", "Master Hubert", 26, 20,
                {"job": "I keep the royal stores. Wouldst thou BUY "
                 "something?"})
    qm.shop = {"kind": "quartermaster", "title": "the royal stores"}
    qm.greet = "Provisions for the road? Wouldst thou BUY something?"
    area.mobs += [doc, qm]
    here = world["castle"]
    for _ in range(3):
        while True:
            x, y = rng.randint(4, 28), rng.randint(14, 22)
            if g[y][x] in ("grass", "cobble") and not area.mob_at(x, y):
                break
        area.mobs.append(townsfolk(rng, world, here, x, y,
                                   {"grass", "cobble"}))
    for _ in range(40):
        x, y = rng.randint(3, W - 4), rng.randint(13, H - 4)
        if g[y][x] == "grass" and not area.mob_at(x, y) and all(
                g[y + dy][x + dx] in ("grass", "forest", "brick")
                for dx, dy in DIRS):
            g[y][x] = "forest"
    return area


def make_dungeon_level(world, di, level, flags):
    d = world["dungeons"][di]
    rng = random.Random("%s:dungeon:%d:%d" % (world["seed"], di, level))
    W, H = 44, 30
    g = blank(W, H, "dwall")
    rooms = []
    for _ in range(400):
        if len(rooms) >= 10:
            break
        rw, rh = rng.randint(4, 9), rng.randint(3, 6)
        rx, ry = rng.randint(1, W - rw - 1), rng.randint(1, H - rh - 1)
        if any(rx - 2 < x + w and x - 2 < rx + rw and
               ry - 2 < y + h and y - 2 < ry + rh for x, y, w, h in rooms):
            continue
        rooms.append((rx, ry, rw, rh))
    for rx, ry, rw, rh in rooms:
        fill(g, rx, ry, rx + rw - 1, ry + rh - 1, "dfloor")
    centers = [(rx + rw // 2, ry + rh // 2) for rx, ry, rw, rh in rooms]

    def corridor(a, b):
        (x1, y1), (x2, y2) = a, b
        if rng.random() < 0.5:
            fill(g, min(x1, x2), y1, max(x1, x2), y1, "dfloor")
            fill(g, x2, min(y1, y2), x2, max(y1, y2), "dfloor")
        else:
            fill(g, x1, min(y1, y2), x1, max(y1, y2), "dfloor")
            fill(g, min(x1, x2), y2, max(x1, x2), y2, "dfloor")

    order = sorted(range(len(rooms)), key=lambda i: centers[i])
    for a, b in zip(order, order[1:]):
        corridor(centers[a], centers[b])
    for _ in range(2):
        corridor(*rng.sample(centers, 2))

    up = centers[0]
    far = max(centers, key=lambda c: abs(c[0] - up[0]) + abs(c[1] - up[1]))
    g[up[1]][up[0]] = "stairs_up"
    last = level == d["levels"]
    area = Area("dungeon", ("dungeon", di, level), g,
                "%s, level %d" % (cap(d["name"]), level), None)
    area.dark = True
    area.start = up
    area.far = far
    if not last:
        g[far[1]][far[0]] = "stairs_down"
        area.down = far
    chests = rng.randint(2, 4)
    if last and d["quest"] is None and not d["lair"]:
        chests += 4
    for _ in range(chests):
        rx, ry, rw, rh = rng.choice(rooms)
        x, y = rng.randint(rx, rx + rw - 1), rng.randint(ry, ry + rh - 1)
        if g[y][x] == "dfloor" and (x, y) not in centers:
            if "chest:%d:%d:%d,%d" % (di, level, x, y) not in flags:
                g[y][x] = "chest"
    if last and d["boss"] and "boss:%d" % di not in flags:
        area.mobs.append(make_boss(d, di, far[0], far[1]))
    for q in world.get("side", []):
        if (q["kind"] == "fetch" and q["dungeon"] == di and
                q["level"] == level and "item:" + q["id"] not in flags):
            spots = [(x, y) for y in range(H) for x in range(W)
                     if g[y][x] == "dfloor" and (x, y) not in centers]
            x, y = random.Random("%s:side:%s" % (world["seed"], q["id"])
                                 ).choice(spots)
            g[y][x] = "chest"
            area.errand_chests[(x, y)] = q["id"]
    furnish(world, area, d, di, level, rooms, centers)
    area.floor = [(x, y) for y in range(H) for x in range(W)
                  if g[y][x] == "dfloor"]
    return area


def furnish(world, area, d, di, level, rooms, centers):
    """Theme, hazards, torches, traps and a locked gate for a dungeon
    level.  A random stream of its own keeps the layout itself unchanged."""
    g = area.grid
    H, W = area.h, area.w
    rng = random.Random("%s:furnish:%d:%d" % (world["seed"], di, level))
    theme = d.get("theme", "stone")
    if theme != "stone":
        area.skin = {t: "%s_%s" % (t, theme) for t in THEMED}
    up, far = area.start, area.far
    far_room = next(r for r, c in zip(rooms, centers) if c == far)

    # Lock the far room (stairs down, or the boss) behind gates if it has
    # few ways in, and leave a key somewhere outside it.
    rx, ry, rw, rh = far_room
    ring = [(x, y) for x in range(rx - 1, rx + rw + 1)
            for y in range(ry - 1, ry + rh + 1)
            if (x in (rx - 1, rx + rw)) != (y in (ry - 1, ry + rh))]
    ways = [(x, y) for x, y in ring if g[y][x] == "dfloor"]
    if 1 <= len(ways) <= 3 and rng.random() < 0.6:
        for x, y in ways:
            g[y][x] = "gate"
        inside = {(x, y) for x in range(rx, rx + rw)
                  for y in range(ry, ry + rh)}
        spots = [(x, y) for y in range(H) for x in range(W)
                 if g[y][x] == "dfloor" and (x, y) not in inside
                 and abs(x - up[0]) + abs(y - up[1]) >= 4]
        if spots:
            area.items[rng.choice(spots)] = "key"
        else:
            for x, y in ways:
                g[y][x] = "dfloor"

    hazard = HAZARDS.get(theme)
    if hazard:
        for _ in range(rng.randint(2, 4)):
            r = rng.choice(rooms)
            if r == far_room or (up[0] - r[0]) in range(r[2]) and \
                    (up[1] - r[1]) in range(r[3]):
                continue
            # never on the room's edge, so there is always a way round
            iw, ih = r[2] - 2, r[3] - 2
            bw, bh = rng.randint(1, min(4, iw)), rng.randint(1, min(3, ih))
            bx = rng.randint(r[0] + 1, r[0] + 1 + iw - bw)
            by = rng.randint(r[1] + 1, r[1] + 1 + ih - bh)
            for y in range(by, by + bh):
                for x in range(bx, bx + bw):
                    if g[y][x] == "dfloor" and (x, y) not in centers \
                            and (x, y) not in area.items:
                        g[y][x] = hazard
    if theme in ("stone", "lair"):
        walls = [(x, y) for y in range(1, H - 1) for x in range(1, W - 1)
                 if g[y][x] == "dwall" and g[y + 1][x] in DUNGEON_FLOOR]
        for x, y in rng.sample(walls, min(len(walls), 10)):
            g[y][x] = "torch"
    spots = [(x, y) for y in range(H) for x in range(W)
             if g[y][x] == "dfloor" and (x, y) not in centers
             and (x, y) not in area.items
             and abs(x - up[0]) + abs(y - up[1]) >= 5]
    area.traps = set(rng.sample(spots, min(len(spots), 1 + level)))


def dungeon_monster(d, level):
    eff = min(6, d["tier"] + level - 1)
    kinds = [k for k, t in MONSTERS.items()
             if t.habitat in ("dungeon", "both") and eff - 2 <= t.tier <= eff]
    return random.choice(kinds)


