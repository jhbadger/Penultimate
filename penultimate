    def new_game(self, hero=None):
        if hero is None:
            hero = self.ask_hero()
            if hero is None:
                if getattr(self, "p", None):
                    return              # cancelled: keep playing this game
                hero = ("Avatar", "Fighter")
        name, cls = hero
        c = CLASSES[cls]
        self.setup_world(random.randrange(1 << 31))
        self.p = dict(START_PLAYER)
        self.p.update(name=name, maxhp=c["hp"], hp=c["hp"], weapon=c["weapon"],
                      armor=c["armor"], spells=list(c["spells"]),
                      sling=c["sling"], pucks=c["pucks"])
        self.p["class"] = cls
        for k in ("str", "dex", "int"):
            self.p[k] = c[k]
        self.p["mp"] = max_mp(self.p)
        self.flags, self.held, self.returned = set(), [], set()
        self.side = {}
        self.release_geese()
        self.turn = 0
        cx, cy = self.world["castle"]
        start = next((cx + dx, cy + dy) for dx, dy in ((0, 1), (-1, 0),
                                                       (1, 0), (0, -1))
                     if self.world["grid"][cy + dy][cx + dx] in LAND)
        self.area = self.world_area
        self.pos = list(start)
        self.world_pos = list(start)
        self.overlay = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.picking = False
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.say("Welcome to %s, %s the %s!" % (
            self.world["realm"], self.p["name"], cls), "quest")
        self.say("Lord Canadian's castle stands beside thee. Walk into it "
                 "and speak with His Lordship: he has a QUEST for thee.")
        self.say("Arrow keys or WASD move. Walk into people to talk and into "
                 "monsters to fight. Press ? for help.", "info")
        self.layout()
        self.save()

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        self.p = dict(START_PLAYER)
        self.p.update(g["player"])
        if self.p["weapon"] not in WEAPONS or self.p["armor"] not in ARMOURS:
            raise ValueError("bad equipment")
        self.p["mp"] = min(self.p["mp"], max_mp(self.p))
        self.flags = set(g.get("flags", []))
        self.held = [int(i) for i in g.get("held", [])]
        self.returned = set(int(i) for i in g.get("returned", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.release_geese()
        self.turn = int(g.get("turn", 0))
        self.world_area.seen = unpack_bits(g["seen"], WORLD_W * WORLD_H)
        self.world_pos = [int(v) for v in g["world_pos"]]
        key = tuple(g["key"])
        self.area = (self.world_area if key[0] == "world"
                     else self.get_area(key))
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        t = self.area.grid[self.pos[1]][self.pos[0]]
        if t not in WALKABLE and not (t in WATER and self.area.kind == "world"):
            self.pos = list(self.area.start)    # the map changed under us
        if self.p["hp"] <= 0:
            self.resurrect()
        self.say("Welcome back to %s, %s." % (self.world["realm"],
                                              self.p["name"]), "quest")
        self.say("Press ? for help.", "info")
        self.layout()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "scale": self.scale}
        if getattr(self, "p", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "held": self.held,
                "returned": sorted(self.returned), "turn": self.turn,
                "side": self.side,
                "key": list(self.area.key), "pos": self.pos,
                "world_pos": self.world_pos,
                "seen": pack_bits(self.world_area.seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()

    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        if key[0] == "town":
            area = make_town(self.world, key[1])
        elif key[0] == "castle":
            area = make_castle(self.world)
        elif key[0] == "dungeon":
            di, level = key[1], key[2]
            area = make_dungeon_level(self.world, di, level, self.flags)
            d = self.world["dungeons"][di]
            sx, sy = area.start
            spots = [p for p in area.floor
                     if abs(p[0] - sx) + abs(p[1] - sy) >= 8]
            for x, y in random.sample(spots, min(len(spots), 5 + 2 * level)):
                area.mobs.append(make_monster(dungeon_monster(d, level), x, y))
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        self.sound.play(sound)
        self.layout()
        self.save()

    def leave_to_world(self):
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] != "dungeon"}
        self.say("You return to the wilderness of %s."
                 % self.world["realm"], "info")
        self.enter(self.world_area, self.world_pos)

    def enter_site(self, kind, i):
        self.world_pos = list(self.pos)
        if kind == "town":
            area = self.get_area(("town", i))
            self.say("You enter %s." % area.name, "info")
        elif kind == "castle":
            area = self.get_area(("castle",))
            self.say("You enter Castle Canadian. A Mountie salutes.", "info")
        else:
            d = self.world["dungeons"][i]
            area = self.get_area(("dungeon", i, 1))
            self.say("You climb down into %s." % d["name"], "info")
            self.enter(area, area.start, "stairs")
            return
        self.enter(area, area.start)

    def change_level(self, delta):
        _, di, level = self.area.key
        if level + delta == 0:
            self.leave_to_world()
            return
        area = self.get_area(("dungeon", di, level + delta))
        self.say("You climb %s to level %d."
                 % ("down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 500:
            self.log.delete("1.0", "%d.0" % (n - 400))
        self.log.config(state="disabled")
        self.log.see("end")

    def max_hp(self):
        return min(BEAVER_HP, self.p["maxhp"]) if self.p["beaver"] \
            else self.p["maxhp"]

    def armour_ac(self):
        return 0 if self.p["beaver"] else ARMOURS[self.p["armor"]].ac

    @staticmethod
    def the(mob):
        return mob.name if mob.boss else "the " + mob.name

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        if self.overlay:
            if self.overlay == "won" and k in ("n", "N"):
                self.new_game()
            elif self.overlay != "won" or k in ("Escape", "Return"):
                self.overlay = None
                self.render()
            return
        if self.picking:
            self.pick_spell(k)
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.fire(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("f", "F"):
            self.ready_sling()
        elif k in ("c", "C"):
            self.choose_spell()
        elif k in ("space", "period", "KP_5"):
            self.say("You wait.", "info")
            self.end_turn()
        elif k in ("p", "P"):
            self.drink()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def move(self, dx, dy):
        if self.busy or self.talk or self.overlay:
            return
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind in ("town", "castle"):
                self.leave_to_world()
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        if t == "gate":
            if a.keys:
                a.keys -= 1
                a.grid[y][x] = "dfloor"
                self.say("You unlock the gate with your iron key.", "good")
                self.sound.play("door")
                self.end_turn()
            else:
                self.say("The gate is locked. There must be a key somewhere "
                         "on this level.", "info")
                self.sound.play("bump")
            return
        if t == "lair" and "final_quest" not in self.flags:
            self.say("A wall of enchanted ice seals the entrance to "
                     "Moosedain's lair. Perhaps Lord Canadian knows a way "
                     "in.", "info")
            self.sound.play("bump")
            return
        p = self.p
        water = a.kind == "world" and t in WATER
        if water and not (p["canoe"] or p["beaver"]):
            self.say("You need a canoe to go out on the water.", "info")
            self.sound.play("bump")
            return
        if t not in WALKABLE and not water:
            self.bump()
            return
        if water and a.grid[self.pos[1]][self.pos[0]] not in WATER:
            self.say("You swim out into the water, as beavers do."
                     if p["beaver"] else
                     "You set your canoe in the water and paddle off.",
                     "info")
        self.pos = [x, y]
        site = self.world["sites"].get((x, y)) if a.kind == "world" else None
        if site:
            self.enter_site(*site)
            return
        if t == "slick":
            x, y = self.slide(dx, dy)
            t = a.grid[y][x]
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        if t == "inukshuk":
            self.visit_inukshuk(x, y)
        elif t == "chest":
            self.open_chest(x, y)
        elif t == "swamp" and not self.p["poison"] and random.random() < 0.15:
            self.p["poison"] = True
            self.say("The swamp's foul vapours poison you!", "bad")
            self.sound.play("hurt")
        wading = a.kind == "dungeon" and self.dungeon_step(x, y)
        self.end_turn()
        if wading and not self.busy:
            self.end_turn()             # wading is slow: monsters gain a turn

    def slide(self, dx, dy):
        """Slide across ice until something stops you."""
        a = self.area
        x, y = self.pos
        moved = False
        while a.grid[y][x] == "slick":
            nx, ny = x + dx, y + dy
            if (not a.inside(nx, ny) or a.grid[ny][nx] not in WALKABLE
                    or a.mob_at(nx, ny)):
                break
            x, y, moved = nx, ny, True
        self.pos = [x, y]
        if moved:
            self.say("Whee! You slide across the ice.", "info")
        return x, y

    def dungeon_step(self, x, y):
        """Keys, traps and hazards underfoot; True if wading (slow)."""
        a, p = self.area, self.p
        if a.items.get((x, y)) == "key":
            del a.items[(x, y)]
            a.keys += 1
            self.say("You pick up an iron key.", "gold")
            self.sound.play("gold")
        if (x, y) in a.traps or a.items.get((x, y)) == "trap":
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            self.spring_trap(x, y)
        t = a.grid[y][x]
        if t == "lava":
            tier = self.world["dungeons"][a.key[1]]["tier"]
            dmg = random.randint(4, 8) + tier
            p["hp"] -= dmg
            self.say("The lava burns you! (%d)" % dmg, "bad")
            self.flash(x, y, "bolt")
            self.sound.play("hurt")
        elif t == "pool":
            self.say("You wade through the cold, dark water.", "info")
            return True
        return False

    def spring_trap(self, x, y):
        a, p = self.area, self.p
        kind = random.choice(("pit", "dart", "alarm"))
        self.sound.play("hurt")
        if kind == "pit":
            dmg = random.randint(3, 8) + a.key[2]
            p["hp"] -= dmg
            self.say("A trapdoor! You tumble into a spiked pit. (%d)" % dmg,
                     "bad")
            self.flash(x, y)
        elif kind == "dart":
            p["hp"] -= random.randint(1, 3)
            p["poison"] = True
            self.say("Click! A poisoned dart strikes you.", "bad")
            self.flash(x, y)
        else:
            self.say("Click! A bell clangs somewhere in the dark. Monsters "
                     "come running!", "bad")
            d = self.world["dungeons"][a.key[1]]
            spots = [s for s in a.floor if 4 <= abs(s[0] - x) +
                     abs(s[1] - y) <= 8 and not a.mob_at(*s)]
            for sx, sy in random.sample(spots, min(2, len(spots))):
                a.mobs.append(make_monster(dungeon_monster(d, a.key[2]),
                                           sx, sy))

    def bump(self):
        self.say("Blocked!", "info")
        self.sound.play("bump")

    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before and a.kind != "dungeon":
            self.say({"dawn": "Dawn breaks.", "day": "The sun is up.",
                      "dusk": "The sun is setting.",
                      "night": "Night falls. Beware what walks in the dark."
                      }[now], "info")
        if a.kind == "world" or (a.kind == "dungeon" and self.turn % 2 == 0):
            if p["food"] > 0:
                p["food"] -= 1
                if p["food"] == 0:
                    self.say("You have run out of food!", "bad")
                elif p["food"] == 30:
                    self.say("Your food is running low.", "bad")
            else:
                p["hp"] -= 1
                if self.turn % 6 == 0:
                    self.say("You are starving!", "bad")
        if p["poison"]:
            p["hp"] -= 1
            if random.random() < 0.05:
                p["poison"] = False
                self.say("The poison has worn off.", "good")
        elif p["food"] > 0 and self.turn % 6 == 0 and p["hp"] < self.max_hp():
            p["hp"] += 1
        if self.turn % 4 == 0 and p["mp"] < max_mp(p) and not p["beaver"]:
            p["mp"] += 1
        if p["light"] > 0:
            p["light"] -= 1
            if p["light"] == 0:
                self.say("Your magical light fades.", "info")
        if p["hp"] <= 0:
            self.die()
            return
        if a.kind == "dungeon":
            px, py = self.pos
            for tx, ty in list(a.traps):
                if abs(tx - px) + abs(ty - py) <= 2 and \
                        random.random() < p["dex"] * 0.015:
                    a.traps.discard((tx, ty))
                    a.items[(tx, ty)] = "trap"
                    self.say("You spot a trap!", "info")
        self.render()               # monsters chase what they can see
        for mob in list(a.mobs):
            if mob not in a.mobs:
                continue
            if mob.hostile:
                self.monster_act(mob)
                if p["hp"] <= 0:
                    self.die()
                    return
            else:
                self.wander(mob)
        if a.kind == "world":
            self.spawn_world()
        elif a.kind == "dungeon":
            self.spawn_dungeon()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if MONSTERS[mob.kind].habitat == "water":
            return t in WATER
        if a.kind == "world":
            return t in LAND
        return t in DUNGEON_FLOOR

    def monster_act(self, mob):
        if "slow" in mob.traits and self.turn % 2:
            return
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if mob.flee > 0:
            mob.flee -= 1
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1]))[:2]:
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return
        if dist == 1:
            self.monster_attack(mob)
            return
        if ("curse" in mob.traits and not self.p["beaver"] and dist <= 5
                and self.line_clear(self.area, mob.x, mob.y, px, py)
                and random.random() < 0.3):
            self.witch_curse(mob)
            return
        if ("ranged" in mob.traits and (dx == 0 or dy == 0) and dist <= 6
                and self.line_clear(self.area, mob.x, mob.y, px, py)
                and random.random() < 0.35):
            self.monster_ranged(mob)
            return
        chase = dist <= 10 and (dist <= 4 or (mob.x, mob.y) in self.visible)
        if "erratic" in mob.traits and random.random() < 0.5:
            chase = False
        if chase:
            steps = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        elif random.random() < 0.5:
            steps = [random.choice(DIRS)]
        else:
            return
        for sx, sy in steps[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                return

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 4)):
            mob.x, mob.y = x, y

    def spawn_world(self):
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if m.goose is not None
                  or abs(m.x - px) + abs(m.y - py) <= 24]
        night = self.phase() == "night"
        if (sum(m.hostile for m in a.mobs) >= 6
                or random.random() > (0.12 if night else 0.07)):
            return
        for _ in range(10):
            ang = random.random() * 2 * math.pi
            r = random.uniform(6, 10)
            x, y = px + round(r * math.cos(ang)), py + round(r * math.sin(ang))
            if not a.inside(x, y) or a.mob_at(x, y):
                continue
            t = a.grid[y][x]
            cx, cy = self.world["castle"]
            danger = min(6, 1 + night +
                         int(math.hypot(x - cx, y - cy) // 8))
            if t == "deep" and random.random() < 0.3:
                kind = "serpent"
            elif t == "forest" and danger >= 2 and random.random() < 0.25:
                kind = "witch"
            elif t in LAND:
                kind = random.choice([
                    k for k, m in MONSTERS.items()
                    if m.habitat in ("world", "both")
                    and danger - 2 <= m.tier <= danger])
            else:
                continue
            a.mobs.append(make_monster(kind, x, y))
            return

    def spawn_dungeon(self):
        a = self.area
        if len(a.mobs) >= 14 or random.random() > 0.02:
            return
        x, y = random.choice(a.floor)
        if (x, y) in self.visible or a.mob_at(x, y) or [x, y] == self.pos:
            return
        d = self.world["dungeons"][a.key[1]]
        a.mobs.append(make_monster(dungeon_monster(d, a.key[2]), x, y))

    # ── Combat ──

    def attack(self, mob):
        p = self.p
        roll = random.randint(1, 20) + p["level"] + p["dex"] // 4
        if roll < 10 + mob.defense:
            self.say("You miss %s." % self.the(mob), "info")
            self.sound.play("miss")
            return
        self.flash(mob.x, mob.y)
        if mob.kind == "moosedain" and (p["weapon"] != "Maple Blade"
                                        or p["beaver"]):
            self.say("Your blow glances off Moosedain's enchanted hide! "
                     "Only the Maple Blade can harm him.", "bad")
            self.sound.play("miss")
            return
        if p["beaver"]:
            dmg = random.randint(*BEAVER_BITE)
        else:
            dmg = max(1, random.randint(*WEAPONS[p["weapon"]].dmg) +
                      (p["str"] - 10) // 3)
        mob.hp -= dmg
        if mob.hp > 0:
            self.say("You %s %s. (%d)" % ("bite" if p["beaver"] else "hit",
                                          self.the(mob), dmg))
            self.sound.play("hit")
            return
        self.kill(mob)

    def kill(self, mob):
        p = self.p
        self.area.mobs.remove(mob)
        gold = random.randint(0, mob.xp // 2 + 1)
        if mob.boss:
            gold += 50 * mob.level
        p["xp"] += mob.xp
        p["gold"] += gold
        self.say("You kill %s! (%d xp%s)" % (
            self.the(mob), mob.xp, ", %d gold" % gold if gold else ""),
            "good")
        self.sound.play("kill")
        for q in self.world["side"]:
            st = self.side.get(q["id"])
            if (q["kind"] == "hunt" and q["monster"] == mob.kind and st
                    and st["state"] == "active" and st["count"] < q["count"]):
                st["count"] += 1
                town = self.world["towns"][q["town"]]["name"]
                self.say("(%d of %d %s for %s in %s%s)" % (
                    st["count"], q["count"], plural(mob.name), q["giver"],
                    town, ": return for thy reward"
                    if st["count"] == q["count"] else ""), "info")
        if mob.boss:
            self.flags.add("boss:%d" % mob.dungeon)
            d = self.world["dungeons"][mob.dungeon]
            if d["artifact"]:
                self.held.append(mob.dungeon)
                self.say("You recover %s! Return it to Lord Canadian."
                         % d["artifact"], "quest")
                self.root.after(400, self.sound.play, "quest")
            elif mob.kind == "moosedain":
                self.flags.add("moosedain_dead")
                self.say("Moosedain the Wicked is no more! Hasten back to "
                         "Lord Canadian with the news.", "quest")
                self.root.after(400, self.sound.play, "quest")
            self.save()

    def monster_attack(self, mob):
        p = self.p
        ac = self.armour_ac()
        if random.randint(1, 20) + mob.level + 2 < 10 + ac + p["dex"] // 5:
            self.say("%s misses you." % cap(self.the(mob)), "info")
            return
        dmg = max(1, random.randint(*mob.dmg) - ac // 3)
        p["hp"] -= dmg
        self.say("%s hits you! (%d)" % (cap(self.the(mob)), dmg), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if "poison" in mob.traits and not p["poison"] and \
                random.random() < 0.3:
            p["poison"] = True
            self.say("You are poisoned!", "bad")

    def monster_ranged(self, mob):
        p = self.p
        ac = self.armour_ac()
        verb = ("hurls a bolt of dark magic" if mob.kind == "moosedain" else
                "breathes fire" if mob.kind == "dragon" else "hurls fire")
        self.sound.play("fire")
        if random.randint(1, 20) + mob.level < 10 + ac + p["dex"] // 5:
            self.say("%s %s, but misses." % (cap(self.the(mob)), verb),
                     "info")
            return
        dmg = max(1, random.randint(*mob.dmg) - ac // 3)
        p["hp"] -= dmg
        self.say("%s %s! (%d)" % (cap(self.the(mob)), verb, dmg), "bad")
        self.flash(*self.pos, tile="bolt")

    def witch_curse(self, mob):
        p = self.p
        self.sound.play("fire")
        self.flash(*self.pos, tile="bolt")
        if random.randint(1, 20) + mob.level < 10 + p["dex"] // 4:
            self.say("%s points her gnarled staff at you and cackles, but "
                     "you shake off the spell." % cap(self.the(mob)), "info")
            return
        p["beaver"] = True
        p["hp"] = min(p["hp"], BEAVER_HP)
        self.say("%s points her gnarled staff at you and cackles... You "
                 "have been turned into a BEAVER!" % cap(self.the(mob)),
                 "bad")
        self.say("You can only bite, you have little strength, and no one "
                 "understands you. Only Lord Canadian can undo such "
                 "magic.", "info")

    def die(self):
        self.busy = True
        self.render()
        self.say("You have died...", "bad")
        self.sound.play("death")
        self.root.after(1800, self.revive)

    def resurrect(self):
        p = self.p
        p["hp"] = p["maxhp"]
        p["poison"] = False
        p["beaver"] = False         # Lord Canadian sees to that, too
        p["mp"] = max_mp(p)
        p["gold"] = 0
        p["food"] = max(p["food"], 100)
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] != "dungeon"}
        self.world_pos = list(self.world["castle"])
        self.area = self.get_area(("castle",))
        self.pos = [16, 6]

    def revive(self):
        self.resurrect()
        self.busy = False
        self.say("A warm light surrounds you... Lord Canadian has "
                 "resurrected you. \"Sorry about that, eh!\" Your gold, "
                 "alas, is lost.", "quest")
        self.enter(self.area, self.pos, "level")

    def open_chest(self, x, y):
        qid = self.area.errand_chests.get((x, y))
        if qid is not None:
            q = self.world["side"][int(qid)]
            self.flags.add("item:" + qid)
            self.area.grid[y][x] = "dfloor"
            self.say("Inside the chest you find %s! %s in %s will be glad "
                     "to see it." % (q["item"], q["giver"],
                                     self.world["towns"][q["town"]]["name"]),
                     "quest")
            self.sound.play("gold")
            return
        _, di, level = self.area.key
        key = "chest:%d:%d:%d,%d" % (di, level, x, y)
        self.flags.add(key)
        self.area.grid[y][x] = "dfloor"
        rng = random.Random("%s:%s" % (self.world["seed"], key))
        d = self.world["dungeons"][di]
        gold = rng.randint(10, 30) * (d["tier"] + level)
        self.p["gold"] += gold
        msg = "You open the chest and find %d gold" % gold
        if rng.random() < 0.3:
            self.p["potions"] += 1
            msg += " and a healing potion"
        self.say(msg + "!", "gold")
        self.sound.play("gold")

    # ── Magic and missiles ──

    def choose_spell(self):
        if self.busy or self.talk or self.overlay:
            return
        p = self.p
        if p["beaver"]:
            self.say("You chitter the magic words, but beavers can't cast "
                     "spells.", "info")
            return
        if not p["spells"]:
            self.say("You know no spells. The mages in the towns sell "
                     "spellbooks.", "info")
            return
        self.say("Cast which spell? (you have %d MP)" % p["mp"], "info")
        for i, n in enumerate(p["spells"], 1):
            self.say("   %d) %-10s %2d MP  %s" % (i, n, SPELLS[n].mp,
                                                 SPELLS[n].desc), "talk")
        self.say("   (press its number, or Escape)", "info")
        self.picking = True

    def pick_spell(self, k):
        self.picking = False
        k = k[3:] if k.startswith("KP_") else k
        spells = self.p["spells"]
        if k.isdigit() and 1 <= int(k) <= len(spells):
            self.cast(spells[int(k) - 1])
        else:
            self.say("Never mind.", "info")

    def cast(self, name):
        p, a = self.p, self.area
        sp = SPELLS[name]
        if p["mp"] < sp.mp:
            self.say("You haven't the magic for %s (%d MP)." % (name, sp.mp),
                     "info")
            return
        if name == "Cure" and not p["poison"]:
            self.say("You are not poisoned.", "info")
            return
        if name == "Portage" and a.kind == "castle":
            self.say("You are already at Castle Canadian.", "info")
            return
        if sp.aimed:
            self.aim = {"spell": name}
            self.say("Cast %s in which direction?" % name, "info")
            return
        p["mp"] -= sp.mp
        self.sound.play("spell")
        if name == "Heal":
            heal = min(self.max_hp() - p["hp"], 8 + p["int"])
            p["hp"] += heal
            self.say("Warmth flows through you. (+%d)" % heal, "good")
        elif name == "Cure":
            p["poison"] = False
            self.say("The poison leaves your blood.", "good")
        elif name == "Light":
            p["light"] = 150
            self.say("A soft, magical glow surrounds you.", "good")
        elif name == "Sorry":
            px, py = self.pos
            fled = [m for m in a.mobs if m.hostile and not m.boss
                    and abs(m.x - px) + abs(m.y - py) <= 5]
            for m in fled:
                m.flee = 8
            if fled:
                self.say("\"Sorry! So sorry! Terribly sorry!\" Touched by "
                         "your apology, %s %s off." % (
                             ", ".join(self.the(m) for m in fled),
                             "runs" if len(fled) == 1 else "run"), "good")
            else:
                self.say("You apologise to no one in particular. It feels "
                         "nice, anyway.", "info")
        elif name == "Portage":
            self.say("You hoist your pack, take a deep breath... and find "
                     "yourself at the gates of Castle Canadian.", "quest")
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dungeon"}
            self.world_pos = list(self.world["castle"])
            self.enter(self.get_area(("castle",)), (16, 21), "spell")
            return
        self.end_turn()

    def ready_sling(self):
        if self.busy or self.talk or self.overlay:
            return
        p = self.p
        if p["beaver"]:
            self.say("Your little paws can't work a sling.", "info")
        elif not p["sling"]:
            self.say("You have no sling. Outfitters sell them.", "info")
        elif p["pucks"] <= 0:
            self.say("You are out of hockey pucks!", "info")
        else:
            self.aim = {"puck": True}
            self.say("Fire a puck in which direction?", "info")

    def fire(self, dx, dy):
        p, a = self.p, self.area
        aim, self.aim = self.aim, None
        if "spell" in aim:
            p["mp"] -= SPELLS[aim["spell"]].mp
            self.sound.play("spell")
            tile, reach = "frost", BOLT_RANGE
            dmg = random.randint(*BOLT_DMG) + p["int"] // 3
            skill = p["int"] // 3
        else:
            p["pucks"] -= 1
            self.sound.play("throw")
            tile, reach = "puck", PUCK_RANGE
            dmg = max(1, random.randint(*PUCK_DMG) + (p["dex"] - 10) // 2)
            skill = p["dex"] // 3
        path, (x, y) = [], self.pos
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y):
                break
            t = a.grid[y][x]
            if t in a.opaque or (t not in WALKABLE and t not in WATER):
                break
            path.append((x, y))
            if a.mob_at(x, y):
                break
        target = a.mob_at(*path[-1]) if path else None
        self.busy = True
        self.fly(path, tile, lambda: self.missile_hit(target, tile, dmg,
                                                        skill))

    def fly(self, path, tile, done):
        """Animate a missile along path, then call done."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        if not path:
            c.itemconfig(self.missile, state="hidden")
            done()
            return
        x, y = path[0]
        i, j = x - self.pos[0] + cols // 2, y - self.pos[1] + rows // 2
        c.coords(self.missile, ox + i * ts, oy + j * ts)
        c.itemconfig(self.missile, image=self.img[tile], state="normal")
        c.tag_raise(self.missile)
        self.root.after(35, self.fly, path[1:], tile, done)

    def missile_hit(self, mob, tile, dmg, skill):
        self.busy = False
        what = "puck" if tile == "puck" else "bolt of frost"
        if mob is None:
            self.say("The %s %s." % (what, "clatters away" if tile == "puck"
                                     else "fizzles out"), "info")
        elif not mob.hostile:
            self.say("The %s bounces off %s. \"Ow! Sorry!\"" % (
                what, mob.title), "info")
        elif random.randint(1, 20) + self.p["level"] + skill < \
                10 + mob.defense:
            self.say("The %s misses %s." % (what, self.the(mob)), "info")
        elif mob.kind == "moosedain" and (tile == "puck" or
                                          self.p["weapon"] != "Maple Blade"):
            self.flash(mob.x, mob.y)
            self.say("The %s glances off Moosedain's enchanted hide!%s" % (
                what, "" if tile == "puck" else " Perhaps with the Maple "
                "Blade in hand..."), "bad")
        else:
            self.flash(mob.x, mob.y)
            mob.hp -= dmg
            if mob.hp > 0:
                self.say("The %s hits %s. (%d)" % (what, self.the(mob), dmg))
                self.sound.play("hit")
            else:
                self.kill(mob)
        self.end_turn()

    def visit_inukshuk(self, x, y):
        key = "inuk:%d,%d" % (x, y)
        if key in self.flags:
            self.say("The inukshuk stands silent, pointing the way home.",
                     "info")
            return
        self.flags.add(key)
        p = self.p
        rng = random.Random("%s:%s" % (self.world["seed"], key))
        gold = rng.randint(60, 160)
        p["gold"] += gold
        p["potions"] += 1
        p["xp"] += 40
        extra = ""
        if p["sling"]:
            p["pucks"] += 10
            extra = ", ten hockey pucks"
        self.say("An inukshuk stands here, built by travellers long ago. "
                 "Beneath its stones you find %d gold%s and a healing "
                 "potion. (+40 xp)" % (gold, extra), "gold")
        self.sound.play("gold")

    def drink(self):
        if self.busy or self.talk or self.overlay:
            return
        p = self.p
        if p["potions"] <= 0:
            self.say("You have no potions!", "info")
            return
        p["potions"] -= 1
        heal = min(self.max_hp() - p["hp"], 15 + 5 * p["level"])
        p["hp"] += heal
        p["poison"] = False
        self.say("You drink a healing potion. (+%d)" % heal, "good")
        self.sound.play("potion")
        self.end_turn()

    # ── Conversation ──

    def speaker(self, mob):
        return mob.name if mob.known else cap(mob.title)

    def npc_say(self, mob, text):
        self.say("%s says: %s" % (self.speaker(mob), text), "talk")

    def start_talk(self, mob):
        if mob.goose is not None:
            self.catch_goose(mob)
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Your interest:")
        self.entry.delete(0, "end")
        self.entry.focus_set()
        if self.p["beaver"] and not mob.lord:
            self.beaver_talk(mob)
            return
        if mob.lord:
            self.lord_greet(mob)
            if self.overlay == "won":
                self.end_talk()
            return
        self.say("You meet %s." % mob.title, "info")
        greet = mob.greet
        if mob.quest is not None:
            st = self.side.get(mob.quest)
            greet = (random.choice(GREETINGS) if st and st["state"] == "done"
                     else "Oh, it's thee! Any luck with my errand?" if st
                     else greet)
        self.npc_say(mob, "Oh! We're closed for the night, sorry. Come back "
                     "in the morning." if self.closed(mob) else greet)
        if mob.recipient is not None:
            self.deliver(mob)
        if mob.quest is not None and self.side.get(mob.quest, {}).get(
                "state") == "active" and self.errand_ready(mob.quest):
            self.finish_errand(mob)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Type a word such as NAME, JOB or NEWS and press "
                     "Return. BYE, or an empty line, ends the "
                     "conversation.)", "info")

    def beaver_talk(self, mob):
        """Nobody understands a beaver; there is no conversation."""
        self.talk = None
        self.talkbar.pack_forget()
        self.say("You squeak and chitter at %s." % mob.title, "info")
        if mob.shop:
            line = "No beavers in the shop, please! Sorry, little fellow."
        elif mob.tile == "guard":
            line = "Move along, little beaver. Unless... art thou trying " \
                   "to tell me something? Lord Canadian would know."
        else:
            line = random.choice(BEAVER_LINES)
            if "%s" in line:
                line = line % self.world["realm"]
        self.npc_say(mob, line)
        self.render()

    def closed(self, mob):
        """Shops close at night, except inns and taverns."""
        return (mob.shop is not None and self.phase() == "night"
                and mob.shop["kind"] not in ("inn", "tavern"))

    def end_talk(self):
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if hasattr(self, "p"):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())

    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            self.prompt.config(text="Your interest:")
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else, then?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, "Safe travels, and mind the geese!"
                         if mob.lord else random.choice(BYES))
            self.end_talk()
            return
        if w.startswith("name"):
            mob.known = True
        if mob.quest is not None and w.split()[0][:4] in ERRAND_WORDS:
            self.errand(mob)
            self.render_chrome()
            return
        if mob.lord:
            reply = self.lord_reply(w)
        elif mob.shop and w[:3] in ("buy", "pur", "sho", "war", "goo"):
            if self.closed(mob):
                self.npc_say(mob, "Sorry, we're closed for the night. Come "
                             "back in the morning, eh!")
                return
            self.list_offers(mob)
            return
        else:
            reply = next((v for k, v in mob.talk.items()
                          if k[:4] == w.split()[0][:4]), None)
        self.npc_say(mob, reply or random.choice((
            "Sorry, I can't help thee with that.",
            "I don't know anything about that, sorry.",
            "Hmm? Sorry, I'm not sure what thou meanest.")))
        self.render_chrome()

    # ── Errands ──

    def release_geese(self):
        """Put the runaway geese of errands not yet done out on the map."""
        a = self.world_area
        a.mobs = [m for m in a.mobs if m.goose is None]
        for q in self.world["side"]:
            if (q["kind"] == "goose" and "goose:" + q["id"] not in self.flags
                    and self.side.get(q["id"], {}).get("state") != "done"):
                g = Mob("goose", q["goose"], *q["home"])
                g.title, g.goose, g.home, g.roam = "a goose", q["id"], \
                    q["home"], LAND
                a.mobs.append(g)

    def catch_goose(self, mob):
        q = self.world["side"][int(mob.goose)]
        self.area.mobs.remove(mob)
        self.flags.add("goose:" + q["id"])
        town = self.world["towns"][q["town"]]["name"]
        self.say("You scoop up %s the goose. She honks indignantly and "
                 "nips your ear." % q["goose"], "quest")
        self.say("Take her home to %s in %s." % (q["giver"], town)
                 if q["id"] in self.side else
                 "Someone in %s must be missing her." % town, "info")
        self.sound.play("gold")
        self.render()

    def errand_ready(self, qid):
        q = self.world["side"][int(qid)]
        st = self.side.get(qid, {})
        if q["kind"] == "hunt":
            return st.get("count", 0) >= q["count"]
        if q["kind"] == "fetch":
            return "item:" + qid in self.flags
        if q["kind"] == "goose":
            return "goose:" + qid in self.flags
        return False                 # parcels are paid for on delivery

    def errand(self, mob):
        """A quest giver asked about their errand."""
        q = self.world["side"][int(mob.quest)]
        st = self.side.get(q["id"])
        if st and st["state"] == "done":
            self.npc_say(mob, "Thou hast done me a great kindness already. "
                         "Thank thee!")
            return
        if st is None:
            self.side[q["id"]] = {"state": "active", "count": 0}
            self.npc_say(mob, errand_text(self.world, q))
            if q["kind"] == "deliver":
                self.say("You take %s." % q["item"], "info")
            if self.errand_ready(q["id"]):
                self.finish_errand(mob)
            else:
                self.say("(Errand accepted. Press J to see your journal.)",
                         "info")
            self.save()
            return
        if self.errand_ready(q["id"]):
            self.finish_errand(mob)
            return
        town = self.world["towns"][q["town"]]
        here = (town["x"], town["y"])
        if q["kind"] == "hunt":
            text = "Thou hast slain %d of the %d %s so far. Keep at it!" % (
                st["count"], q["count"], plural(MONSTERS[q["monster"]].name))
        elif q["kind"] == "fetch":
            d = self.world["dungeons"][q["dungeon"]]
            text = "Hast thou found %s? It's in %s, on level %d." % (
                q["item"], d["name"], q["level"])
        elif q["kind"] == "goose":
            text = "Hast thou found %s? She was last seen %s of town." % (
                q["goose"], where(here, q["home"]))
        else:
            t = self.world["towns"][q["to_town"]]
            text = "Hast thou delivered it yet? %s is %s in %s." % (
                q["to"], SHOP_TITLES[q["to_shop"]], t["name"])
        self.npc_say(mob, text)

    def reward(self, q):
        p = self.p
        p["gold"] += q["gold"]
        p["xp"] += q["xp"]
        self.side[q["id"]]["state"] = "done"
        self.say("(+%d gold, +%d xp)" % (q["gold"], q["xp"]), "good")
        self.root.after(200, self.sound.play, "quest")
        self.save()

    def finish_errand(self, mob):
        q = self.world["side"][int(mob.quest)]
        if q["kind"] == "hunt":
            text = "Thou hast done it! We can sleep soundly again."
        elif q["kind"] == "fetch":
            text = "Thou found %s! I could hug thee. Sorry, is that too " \
                   "much?" % q["item"]
        else:
            text = "%s! Oh, my sweet girl! (%s honks, and bites %s.)" % (
                q["goose"], q["goose"], q["giver"])
        self.npc_say(mob, text + " Here's thy reward, as promised.")
        self.reward(q)

    def deliver(self, mob):
        q = self.world["side"][int(mob.recipient)]
        st = self.side.get(q["id"])
        if not st or st["state"] != "active":
            return
        giver_town = self.world["towns"][q["town"]]["name"]
        self.say("You hand over %s from %s." % (q["item"], q["giver"]),
                 "info")
        self.npc_say(mob, "From %s in %s? How thoughtful! Here's %d gold "
                     "for thy trouble." % (q["giver"], giver_town, q["gold"]))
        self.reward(q)

    def journal(self):
        if self.busy or self.talk:
            return
        w = self.world
        castle = w["castle"]
        self.say("~ Journal ~", "quest")
        di = self.current_quest()
        if "won" in self.flags:
            main = "Moosedain is defeated. %s is saved!" % w["realm"]
        elif "moosedain_dead" in self.flags:
            main = "Tell Lord Canadian that Moosedain is dead."
        elif "final_quest" in self.flags:
            lair = w["dungeons"][5]
            main = "Slay Moosedain in his lair, %s of the castle." % where(
                castle, (lair["x"], lair["y"]))
        elif di is None:
            main = "Bring the relics to Lord Canadian."
        elif di in self.held:
            main = "Bring %s back to Lord Canadian." % w["dungeons"][di][
                "artifact"]
        else:
            d = w["dungeons"][di]
            main = "Recover %s from %s, %s of the castle." % (
                d["artifact"], d["name"], where(castle, (d["x"], d["y"])))
        self.say("Quest: " + main, "talk")
        active = [q for q in w["side"]
                  if self.side.get(q["id"], {}).get("state") == "active"]
        done = sum(v["state"] == "done" for v in self.side.values())
        for q in active:
            st = self.side[q["id"]]
            town = w["towns"][q["town"]]["name"]
            if q["kind"] == "hunt":
                what = "slay %d %s (%d so far)" % (
                    q["count"], plural(MONSTERS[q["monster"]].name),
                    st["count"])
            elif q["kind"] == "fetch":
                d = w["dungeons"][q["dungeon"]]
                what = "find %s in %s, level %d" % (q["item"], d["name"],
                                                     q["level"])
            elif q["kind"] == "goose":
                what = "catch %s the goose, %s of %s" % (
                    q["goose"], where((w["towns"][q["town"]]["x"],
                                       w["towns"][q["town"]]["y"]),
                                      q["home"]), town)
            else:
                what = "take %s to %s, %s in %s" % (
                    q["item"], q["to"], SHOP_TITLES[q["to_shop"]],
                    w["towns"][q["to_town"]]["name"])
            ready = self.errand_ready(q["id"])
            self.say("Errand for %s in %s: %s%s" % (
                q["giver"], town, what,
                " (done: return for thy reward)" if ready else ""), "talk")
        if not active:
            self.say("No errands under way. Townsfolk who need HELP will "
                     "say so.", "info")
        if done:
            self.say("Errands completed: %d of %d." % (done, len(w["side"])),
                     "info")

    # ── Shops ──

    def offers(self, mob):
        s, p = mob.shop, self.p
        if s["kind"] == "weapon":
            return [("%s (%d-%d)" % ((n,) + WEAPONS[n].dmg), WEAPONS[n].price,
                     "weapon", n) for n in s["stock"]]
        if s["kind"] == "armor":
            return [("%s (AC %d)" % (n, ARMOURS[n].ac), ARMOURS[n].price,
                     "armor", n) for n in s["stock"]]
        if s["kind"] == "healer":
            return [("Healing potion", 25, "potion", None),
                    ("Cure poison", 15, "cure", None),
                    ("Heal all wounds", max(5, p["maxhp"] - p["hp"]),
                     "heal", None)]
        if s["kind"] == "inn":
            return [("A room for the night", 8 + 4 * p["level"], "room",
                     None)]
        if s["kind"] == "tavern":
            return [("Rations (50 meals)", 15, "food", None),
                    ("A mug of ale", 2, "ale", None)]
        if s["kind"] == "outfitter":
            return [("Canoe", 100, "canoe", None),
                    ("Hockey puck sling", 40, "sling", None),
                    ("20 hockey pucks", 10, "pucks", None),
                    ("Rations (50 meals)", 15, "food", None)]
        if s["kind"] == "mage":
            return [("Spellbook: %s (%d MP)" % (n, SPELLS[n].mp),
                     SPELLS[n].price, "spell", n) for n in s["stock"]]
        return [("Rations (50 meals)", 18, "food", None),
                ("Healing potion", 30, "potion", None)]

    def list_offers(self, mob):
        self.npc_say(mob, "Here's what I have:")
        for i, (label, price, _, _) in enumerate(self.offers(mob), 1):
            self.say("   %d) %-24s %5d gold" % (i, label, price), "gold")
        self.say("You have %d gold." % self.p["gold"], "info")
        self.talk["mode"] = "buy"
        self.prompt.config(text="Which one (number)?")

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Sorry, I don't have that.")
            return
        label, price, kind, arg = offers[n - 1]
        if kind == "weapon" and WEAPONS[arg].price <= \
                WEAPONS[p["weapon"]].price:
            self.npc_say(mob, "That's no better than thy %s!" % p["weapon"])
            return
        if kind == "armor" and ARMOURS[arg].price <= ARMOURS[p["armor"]].price:
            self.npc_say(mob, "That's no better than thy %s!" % p["armor"])
            return
        if kind in ("canoe", "sling") and p[kind]:
            self.npc_say(mob, "Thou hast one already!")
            return
        if kind == "spell" and arg in p["spells"]:
            self.npc_say(mob, "Thou knowest that spell already.")
            return
        if kind == "cure" and not p["poison"]:
            self.npc_say(mob, "Thou art not poisoned. Lucky thee!")
            return
        if kind == "heal" and p["hp"] >= p["maxhp"]:
            self.npc_say(mob, "Thou art not hurt.")
            return
        trade = 0
        if kind == "weapon":
            trade = WEAPONS[p["weapon"]].price // 2
        elif kind == "armor":
            trade = ARMOURS[p["armor"]].price // 2
        cost = price - trade
        if cost > p["gold"]:
            self.npc_say(mob, "Sorry, thou canst not afford that.")
            return
        p["gold"] -= cost
        self.sound.play("gold")
        if kind == "weapon":
            if trade:
                self.npc_say(mob, "I'll take thy %s in trade, %d gold off."
                             % (p["weapon"], trade))
            p["weapon"] = arg
            self.npc_say(mob, "Here is thy %s. Use it well!" % arg)
        elif kind == "armor":
            if trade:
                self.npc_say(mob, "I'll take thy %s in trade, %d gold off."
                             % (p["armor"], trade))
            p["armor"] = arg
            self.npc_say(mob, "Thy %s fits thee perfectly." % arg)
        elif kind == "potion":
            p["potions"] += 1
            self.npc_say(mob, "One healing potion. Drink it with P.")
        elif kind == "cure":
            p["poison"] = False
            self.npc_say(mob, "The poison is gone from thy blood.")
        elif kind in ("heal", "room"):
            p["hp"] = p["maxhp"]
            self.npc_say(mob, "Thy wounds are healed." if kind == "heal" else
                         "Thou sleepest soundly, and wakest refreshed.")
            if kind == "room":
                p["mp"] = max_mp(p)
                h = self.turn * 24 // DAY + 8          # sleep till 8 am
                h = (h // 24 + (h % 24 >= 8)) * 24 + 8
                self.turn = (h - 8) * DAY // 24
                self.say("It is morning, day %d." % self.clock()[0], "info")
        elif kind == "canoe":
            p["canoe"] = True
            self.npc_say(mob, "A fine cedar canoe! Carry it on thy back, and "
                         "paddle out wherever there's water. Portage, we "
                         "call it.")
        elif kind == "sling":
            p["sling"] = True
            p["pucks"] += 10
            self.npc_say(mob, "Here's a sling, and ten pucks to start. Press "
                         "F to fire.")
        elif kind == "pucks":
            p["pucks"] += 20
            self.npc_say(mob, "Twenty pucks. Keep thy head up!")
        elif kind == "spell":
            p["spells"].append(arg)
            self.npc_say(mob, "The %s spell: study it well. Press C to cast."
                         % arg)
        elif kind == "food":
            p["food"] += 50
            self.npc_say(mob, "Fifty meals of rations. Don't eat them all at "
                         "once!")
        elif kind == "ale":
            t = self.world["towns"][self.area.key[1]] \
                if self.area.kind == "town" else None
            here = (t["x"], t["y"]) if t else self.world["castle"]
            self.npc_say(mob, "Cheers! Here's what I hear: " +
                         random.choice(town_rumours(self.world, here)))
        self.render_chrome()

    # ── Lord Canadian ──

    def lord_greet(self, mob):
        p = self.p
        if p["beaver"]:
            self.say("You waddle up to the throne.", "info")
            self.npc_say(mob, "Goodness, a beaver! Wait... those eyes... "
                         "%s, is that thee? One of Moosedain's wood "
                         "witches, I'll wager. Hold still, sorry, this "
                         "might tickle." % p["name"])
            p["beaver"] = False
            self.say("Lord Canadian waves his sceptre. You grow taller, "
                     "your tail shrinks away, and wood looks much less "
                     "tasty. You are yourself again!", "quest")
            self.sound.play("level")
        else:
            self.say("You kneel before Lord Canadian.", "info")
        for di in list(self.held):
            d = self.world["dungeons"][di]
            self.held.remove(di)
            self.returned.add(di)
            gold, xp = 150 * d["tier"], 100 * d["tier"]
            p["gold"] += gold
            p["xp"] += xp
            self.npc_say(mob, "Thou hast recovered %s! Canada... er, %s "
                         "thanks thee. Take this reward of %d gold." % (
                             d["artifact"], self.world["realm"], gold),
                         )
            self.say("(+%d xp, +%d gold)" % (xp, gold), "good")
            self.sound.play("quest")
        raised = False
        g = CLASSES.get(p["class"], CLASSES["Fighter"])["gain"]
        while p["level"] < MAX_LEVEL and p["xp"] >= xp_needed(p["level"]):
            p["level"] += 1
            gain = random.randint(*g["hp"])
            p["maxhp"] += gain
            for k in ("str", "dex", "int"):
                p[k] += g[k] + random.randint(0, 1)
            raised = True
            self.say("Thou art now level %d! (+%d max HP)" % (p["level"],
                                                              gain), "quest")
        if raised:
            self.root.after(300, self.sound.play, "level")
        if p["hp"] < p["maxhp"] or p["poison"] or p["mp"] < max_mp(p):
            p["hp"] = p["maxhp"]
            p["mp"] = max_mp(p)
            p["poison"] = False
            self.say("Lord Canadian lays his hands upon thee. Thy wounds "
                     "are healed.", "good")
        if "moosedain_dead" in self.flags and "won" not in self.flags:
            self.flags.add("won")
            self.npc_say(mob, "Moosedain is defeated! %s is saved! I "
                         "declare a holiday, with fireworks and pancakes. "
                         "And sorry it took so long to thank thee properly."
                         % self.world["realm"])
            self.overlay = "won"
            self.root.after(300, self.sound.play, "quest")
            self.save()
            return
        self.npc_say(mob, "Welcome, %s! How may I help thee, eh? (Ask me "
                     "about thy QUEST.)" % p["name"])
        self.save()

    def current_quest(self):
        for di in self.world["quests"]:
            if di not in self.returned:
                return di
        return None

    def lord_reply(self, w):
        p, world = self.p, self.world
        k = w.split()[0][:4]
        castle = world["castle"]
        if k == "name":
            return "I am Lord Canadian, ruler of %s. Sorry, I should have " \
                   "introduced myself sooner." % world["realm"]
        if k == "job":
            return "I rule this fair and chilly land. Mostly I apologise " \
                   "to people. Thou couldst help me with a QUEST."
        if k in ("ques", "miss", "task"):
