    # ── Images ──

    def load_images(self):
        """16px tiles from TILE_PNG, plus darkened copies of the terrain (for
        remembered dungeon squares) and an average colour for the map."""
        self.base, self.dark, self.avg = {}, {}, {}
        for name, data in TILE_PNG.items():
            img = tk.PhotoImage(data="".join(data))
            self.base[name] = img
            if name in SPRITES:
                continue
            rows, tot = [], [0, 0, 0]
            for y in range(16):
                row = []
                for x in range(16):
                    c = img.get(x, y)
                    if isinstance(c, str):
                        c = tuple(int(v) for v in c.split())
                    for i in range(3):
                        tot[i] += c[i]
                    row.append("#%02x%02x%02x" % tuple(int(v * 0.38)
                                                       for v in c[:3]))
                rows.append("{" + " ".join(row) + "}")
            dark = tk.PhotoImage(width=16, height=16)
            dark.put(" ".join(rows))
            self.dark[name] = dark
            self.avg[name] = "#%02x%02x%02x" % tuple(v // 256 for v in tot)
        self.scale_images()

    def scale_images(self):
        s = self.scale
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.dimg = {n: i.zoom(s) for n, i in self.dark.items()}

    # ── Game setup ──

    def setup_world(self, seed):
        self.world = generate_world(seed)
        self.world_area = Area("world", ("world",), self.world["grid"],
                               self.world["realm"], "deep")
        self.cache = {}

    def new_game(self):
        self.setup_world(random.randrange(1 << 31))
        self.p = dict(START_PLAYER)
        self.flags, self.held, self.returned = set(), [], set()
        self.turn = 0
        cx, cy = self.world["castle"]
        start = next((cx + dx, cy + dy) for dx, dy in ((0, 1), (-1, 0),
                                                       (1, 0), (0, -1))
                     if self.world["grid"][cy + dy][cx + dx] in LAND)
        self.area = self.world_area
        self.pos = list(start)
        self.world_pos = list(start)
        self.overlay = None
        self.end_talk()
        self.busy = False
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.say("Welcome to %s, %s!" % (self.world["realm"],
                                         self.p["name"]), "quest")
        self.say("Lord Canadian's castle stands beside thee. Walk into it "
                 "and speak with His Lordship: he has a QUEST for thee.")
        self.say("Arrow keys or WASD move. Walk into people to talk and into "
                 "monsters to fight. Press ? for help.", "info")
        self.layout()
        self.save()

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        self.p = dict(START_PLAYER)
        self.p.update(g["player"])
        if self.p["weapon"] not in WEAPONS or self.p["armor"] not in ARMOURS:
            raise ValueError("bad equipment")
        self.flags = set(g.get("flags", []))
        self.held = [int(i) for i in g.get("held", [])]
        self.returned = set(int(i) for i in g.get("returned", []))
        self.turn = int(g.get("turn", 0))
        self.world_area.seen = unpack_bits(g["seen"], WORLD_W * WORLD_H)
        self.world_pos = [int(v) for v in g["world_pos"]]
        key = tuple(g["key"])
        self.area = (self.world_area if key[0] == "world"
                     else self.get_area(key))
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if self.p["hp"] <= 0:
            self.resurrect()
        self.say("Welcome back to %s, %s." % (self.world["realm"],
                                              self.p["name"]), "quest")
        self.say("Press ? for help.", "info")
        self.layout()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "scale": self.scale}
        if getattr(self, "p", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "held": self.held,
                "returned": sorted(self.returned), "turn": self.turn,
                "key": list(self.area.key), "pos": self.pos,
                "world_pos": self.world_pos,
                "seen": pack_bits(self.world_area.seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()

    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        if key[0] == "town":
            area = make_town(self.world, key[1])
        elif key[0] == "castle":
            area = make_castle(self.world)
        elif key[0] == "dungeon":
            di, level = key[1], key[2]
            area = make_dungeon_level(self.world, di, level, self.flags)
            d = self.world["dungeons"][di]
            sx, sy = area.start
            spots = [p for p in area.floor
                     if abs(p[0] - sx) + abs(p[1] - sy) >= 8]
            for x, y in random.sample(spots, min(len(spots), 5 + 2 * level)):
                area.mobs.append(make_monster(dungeon_monster(d, level), x, y))
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        self.sound.play(sound)
        self.layout()
        self.save()

    def leave_to_world(self):
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] != "dungeon"}
        self.say("You return to the wilderness of %s."
                 % self.world["realm"], "info")
        self.enter(self.world_area, self.world_pos)

    def enter_site(self, kind, i):
        self.world_pos = list(self.pos)
        if kind == "town":
            area = self.get_area(("town", i))
            self.say("You enter %s." % area.name, "info")
        elif kind == "castle":
            area = self.get_area(("castle",))
            self.say("You enter Castle Canadian. A Mountie salutes.", "info")
        else:
            d = self.world["dungeons"][i]
            area = self.get_area(("dungeon", i, 1))
            self.say("You climb down into %s." % d["name"], "info")
            self.enter(area, area.start, "stairs")
            return
        self.enter(area, area.start)

    def change_level(self, delta):
        _, di, level = self.area.key
        if level + delta == 0:
            self.leave_to_world()
            return
        area = self.get_area(("dungeon", di, level + delta))
        self.say("You climb %s to level %d."
                 % ("down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 500:
            self.log.delete("1.0", "%d.0" % (n - 400))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss else "the " + mob.name

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        if self.overlay:
            if self.overlay == "won" and k in ("n", "N"):
                self.new_game()
            elif self.overlay != "won" or k in ("Escape", "Return"):
                self.overlay = None
                self.render()
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("space", "period", "KP_5"):
            self.say("You wait.", "info")
            self.end_turn()
        elif k in ("p", "P"):
            self.drink()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def move(self, dx, dy):
        if self.busy or self.talk or self.overlay:
            return
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind in ("town", "castle"):
                self.leave_to_world()
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        if t == "lair" and "final_quest" not in self.flags:
            self.say("A wall of enchanted ice seals the entrance to "
                     "Moosedain's lair. Perhaps Lord Canadian knows a way "
                     "in.", "info")
            self.sound.play("bump")
            return
        if t not in WALKABLE:
            self.bump()
            return
        self.pos = [x, y]
        site = self.world["sites"].get((x, y)) if a.kind == "world" else None
        if site:
            self.enter_site(*site)
            return
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        if t == "chest":
            self.open_chest(x, y)
        elif t == "swamp" and not self.p["poison"] and random.random() < 0.15:
            self.p["poison"] = True
            self.say("The swamp's foul vapours poison you!", "bad")
            self.sound.play("hurt")
        self.end_turn()

    def bump(self):
        self.say("Blocked!", "info")
        self.sound.play("bump")

    def end_turn(self):
        p, a = self.p, self.area
        self.turn += 1
        if a.kind == "world" or (a.kind == "dungeon" and self.turn % 2 == 0):
            if p["food"] > 0:
                p["food"] -= 1
                if p["food"] == 0:
                    self.say("You have run out of food!", "bad")
                elif p["food"] == 30:
                    self.say("Your food is running low.", "bad")
            else:
                p["hp"] -= 1
                if self.turn % 6 == 0:
                    self.say("You are starving!", "bad")
        if p["poison"]:
            p["hp"] -= 1
            if random.random() < 0.05:
                p["poison"] = False
                self.say("The poison has worn off.", "good")
        elif p["food"] > 0 and self.turn % 6 == 0 and p["hp"] < p["maxhp"]:
            p["hp"] += 1
        if p["hp"] <= 0:
            self.die()
            return
        self.render()               # monsters chase what they can see
        for mob in list(a.mobs):
            if mob not in a.mobs:
                continue
            if mob.hostile:
                self.monster_act(mob)
                if p["hp"] <= 0:
                    self.die()
                    return
            else:
                self.wander(mob)
        if a.kind == "world":
            self.spawn_world()
        elif a.kind == "dungeon":
            self.spawn_dungeon()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if MONSTERS[mob.kind].habitat == "water":
            return t in WATER
        if a.kind == "world":
            return t in LAND
        return t in DUNGEON_FLOOR

    def monster_act(self, mob):
        if "slow" in mob.traits and self.turn % 2:
            return
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if dist == 1:
            self.monster_attack(mob)
            return
        if ("ranged" in mob.traits and (dx == 0 or dy == 0) and dist <= 6
                and self.line_clear(self.area, mob.x, mob.y, px, py)
                and random.random() < 0.35):
            self.monster_ranged(mob)
            return
        chase = dist <= 10 and (dist <= 4 or (mob.x, mob.y) in self.visible)
        if "erratic" in mob.traits and random.random() < 0.5:
            chase = False
        if chase:
            steps = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        elif random.random() < 0.5:
            steps = [random.choice(DIRS)]
        else:
            return
        for sx, sy in steps[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                return

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos):
            mob.x, mob.y = x, y

    def spawn_world(self):
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if abs(m.x - px) + abs(m.y - py) <= 24]
        if len(a.mobs) >= 6 or random.random() > 0.07:
            return
        for _ in range(10):
            ang = random.random() * 2 * math.pi
            r = random.uniform(6, 10)
            x, y = px + round(r * math.cos(ang)), py + round(r * math.sin(ang))
            if not a.inside(x, y) or a.mob_at(x, y):
                continue
            t = a.grid[y][x]
            if t == "deep" and random.random() < 0.3:
                kind = "serpent"
            elif t in LAND:
                cx, cy = self.world["castle"]
                danger = min(6, 1 + int(math.hypot(x - cx, y - cy) // 8))
                kind = random.choice([
                    k for k, m in MONSTERS.items()
                    if m.habitat in ("world", "both")
                    and danger - 2 <= m.tier <= danger])
            else:
                continue
            a.mobs.append(make_monster(kind, x, y))
            return

    def spawn_dungeon(self):
        a = self.area
        if len(a.mobs) >= 14 or random.random() > 0.02:
            return
        x, y = random.choice(a.floor)
        if (x, y) in self.visible or a.mob_at(x, y) or [x, y] == self.pos:
            return
        d = self.world["dungeons"][a.key[1]]
        a.mobs.append(make_monster(dungeon_monster(d, a.key[2]), x, y))

    # ── Combat ──

    def attack(self, mob):
        p = self.p
        roll = random.randint(1, 20) + p["level"] + p["dex"] // 4
        if roll < 10 + mob.defense:
            self.say("You miss %s." % self.the(mob), "info")
            self.sound.play("miss")
            return
        self.flash(mob.x, mob.y)
        if mob.kind == "moosedain" and p["weapon"] != "Maple Blade":
            self.say("Your blow glances off Moosedain's enchanted hide! "
                     "Only the Maple Blade can harm him.", "bad")
            self.sound.play("miss")
            return
        dmg = max(1, random.randint(*WEAPONS[p["weapon"]].dmg) +
                  (p["str"] - 10) // 3)
        mob.hp -= dmg
        if mob.hp > 0:
            self.say("You hit %s. (%d)" % (self.the(mob), dmg))
            self.sound.play("hit")
            return
        self.area.mobs.remove(mob)
        gold = random.randint(0, mob.xp // 2 + 1)
        if mob.boss:
            gold += 50 * mob.level
        p["xp"] += mob.xp
        p["gold"] += gold
        self.say("You kill %s! (%d xp%s)" % (
            self.the(mob), mob.xp, ", %d gold" % gold if gold else ""),
            "good")
        self.sound.play("kill")
        if mob.boss:
            self.flags.add("boss:%d" % mob.dungeon)
            d = self.world["dungeons"][mob.dungeon]
            if d["artifact"]:
                self.held.append(mob.dungeon)
                self.say("You recover %s! Return it to Lord Canadian."
                         % d["artifact"], "quest")
                self.root.after(400, self.sound.play, "quest")
            elif mob.kind == "moosedain":
                self.flags.add("moosedain_dead")
                self.say("Moosedain the Wicked is no more! Hasten back to "
                         "Lord Canadian with the news.", "quest")
                self.root.after(400, self.sound.play, "quest")
            self.save()

    def monster_attack(self, mob):
        p = self.p
        ac = ARMOURS[p["armor"]].ac
        if random.randint(1, 20) + mob.level + 2 < 10 + ac + p["dex"] // 5:
            self.say("%s misses you." % cap(self.the(mob)), "info")
            return
        dmg = max(1, random.randint(*mob.dmg) - ac // 3)
        p["hp"] -= dmg
        self.say("%s hits you! (%d)" % (cap(self.the(mob)), dmg), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if "poison" in mob.traits and not p["poison"] and \
                random.random() < 0.3:
            p["poison"] = True
            self.say("You are poisoned!", "bad")

    def monster_ranged(self, mob):
        p = self.p
        ac = ARMOURS[p["armor"]].ac
        verb = ("hurls a bolt of dark magic" if mob.kind == "moosedain" else
                "breathes fire" if mob.kind == "dragon" else "hurls fire")
        self.sound.play("fire")
        if random.randint(1, 20) + mob.level < 10 + ac + p["dex"] // 5:
            self.say("%s %s, but misses." % (cap(self.the(mob)), verb),
                     "info")
            return
        dmg = max(1, random.randint(*mob.dmg) - ac // 3)
        p["hp"] -= dmg
        self.say("%s %s! (%d)" % (cap(self.the(mob)), verb, dmg), "bad")
        self.flash(*self.pos, tile="bolt")

    def die(self):
        self.busy = True
        self.render()
        self.say("You have died...", "bad")
        self.sound.play("death")
        self.root.after(1800, self.revive)

    def resurrect(self):
        p = self.p
        p["hp"] = p["maxhp"]
        p["poison"] = False
        p["gold"] = 0
        p["food"] = max(p["food"], 100)
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] != "dungeon"}
        self.world_pos = list(self.world["castle"])
        self.area = self.get_area(("castle",))
        self.pos = [16, 6]

    def revive(self):
        self.resurrect()
        self.busy = False
        self.say("A warm light surrounds you... Lord Canadian has "
                 "resurrected you. \"Sorry about that, eh!\" Your gold, "
                 "alas, is lost.", "quest")
        self.enter(self.area, self.pos, "level")

    def open_chest(self, x, y):
        _, di, level = self.area.key
        key = "chest:%d:%d:%d,%d" % (di, level, x, y)
        self.flags.add(key)
        self.area.grid[y][x] = "dfloor"
        rng = random.Random("%s:%s" % (self.world["seed"], key))
        d = self.world["dungeons"][di]
        gold = rng.randint(10, 30) * (d["tier"] + level)
        self.p["gold"] += gold
        msg = "You open the chest and find %d gold" % gold
        if rng.random() < 0.3:
            self.p["potions"] += 1
            msg += " and a healing potion"
        self.say(msg + "!", "gold")
        self.sound.play("gold")

    def drink(self):
        if self.busy or self.talk or self.overlay:
            return
        p = self.p
        if p["potions"] <= 0:
            self.say("You have no potions!", "info")
            return
        p["potions"] -= 1
        heal = min(p["maxhp"] - p["hp"], 15 + 5 * p["level"])
        p["hp"] += heal
        p["poison"] = False
        self.say("You drink a healing potion. (+%d)" % heal, "good")
        self.sound.play("potion")
        self.end_turn()

    # ── Conversation ──

    def speaker(self, mob):
        return mob.name if mob.known else cap(mob.title)

    def npc_say(self, mob, text):
        self.say("%s says: %s" % (self.speaker(mob), text), "talk")

    def start_talk(self, mob):
        self.talk = {"mob": mob, "mode": "kw"}
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Your interest:")
        self.entry.delete(0, "end")
        self.entry.focus_set()
        if mob.lord:
            self.lord_greet(mob)
            if self.overlay == "won":
                self.end_talk()
            return
        self.say("You meet %s." % mob.title, "info")
        self.npc_say(mob, mob.greet)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Type a word such as NAME, JOB or NEWS and press "
                     "Return. BYE, or an empty line, ends the "
                     "conversation.)", "info")

    def end_talk(self):
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if hasattr(self, "p"):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())

    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            self.prompt.config(text="Your interest:")
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else, then?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, "Safe travels, and mind the geese!"
                         if mob.lord else random.choice(BYES))
            self.end_talk()
            return
        if w.startswith("name"):
            mob.known = True
        if mob.lord:
            reply = self.lord_reply(w)
        elif mob.shop and w[:3] in ("buy", "pur", "sho", "war", "goo"):
            self.list_offers(mob)
            return
        else:
            reply = next((v for k, v in mob.talk.items()
                          if k[:4] == w.split()[0][:4]), None)
        self.npc_say(mob, reply or random.choice((
            "Sorry, I can't help thee with that.",
            "I don't know anything about that, sorry.",
            "Hmm? Sorry, I'm not sure what thou meanest.")))
        self.render_chrome()

    # ── Shops ──

    def offers(self, mob):
        s, p = mob.shop, self.p
        if s["kind"] == "weapon":
            return [("%s (%d-%d)" % ((n,) + WEAPONS[n].dmg), WEAPONS[n].price,
                     "weapon", n) for n in s["stock"]]
        if s["kind"] == "armor":
            return [("%s (AC %d)" % (n, ARMOURS[n].ac), ARMOURS[n].price,
                     "armor", n) for n in s["stock"]]
        if s["kind"] == "healer":
            return [("Healing potion", 25, "potion", None),
                    ("Cure poison", 15, "cure", None),
                    ("Heal all wounds", max(5, p["maxhp"] - p["hp"]),
                     "heal", None)]
        if s["kind"] == "inn":
            return [("A room for the night", 8 + 4 * p["level"], "room",
                     None)]
        if s["kind"] == "tavern":
            return [("Rations (50 meals)", 15, "food", None),
                    ("A mug of ale", 2, "ale", None)]
        return [("Rations (50 meals)", 18, "food", None),
                ("Healing potion", 30, "potion", None)]

    def list_offers(self, mob):
        self.npc_say(mob, "Here's what I have:")
        for i, (label, price, _, _) in enumerate(self.offers(mob), 1):
            self.say("   %d) %-24s %5d gold" % (i, label, price), "gold")
        self.say("You have %d gold." % self.p["gold"], "info")
        self.talk["mode"] = "buy"
        self.prompt.config(text="Which one (number)?")

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Sorry, I don't have that.")
            return
        label, price, kind, arg = offers[n - 1]
        if kind == "weapon" and WEAPONS[arg].price <= \
                WEAPONS[p["weapon"]].price:
            self.npc_say(mob, "That's no better than thy %s!" % p["weapon"])
            return
        if kind == "armor" and ARMOURS[arg].price <= ARMOURS[p["armor"]].price:
            self.npc_say(mob, "That's no better than thy %s!" % p["armor"])
            return
        if kind == "cure" and not p["poison"]:
            self.npc_say(mob, "Thou art not poisoned. Lucky thee!")
            return
        if kind == "heal" and p["hp"] >= p["maxhp"]:
            self.npc_say(mob, "Thou art not hurt.")
            return
        trade = 0
        if kind == "weapon":
            trade = WEAPONS[p["weapon"]].price // 2
        elif kind == "armor":
            trade = ARMOURS[p["armor"]].price // 2
        cost = price - trade
        if cost > p["gold"]:
            self.npc_say(mob, "Sorry, thou canst not afford that.")
            return
        p["gold"] -= cost
        self.sound.play("gold")
        if kind == "weapon":
            if trade:
                self.npc_say(mob, "I'll take thy %s in trade, %d gold off."
                             % (p["weapon"], trade))
            p["weapon"] = arg
            self.npc_say(mob, "Here is thy %s. Use it well!" % arg)
        elif kind == "armor":
            if trade:
                self.npc_say(mob, "I'll take thy %s in trade, %d gold off."
                             % (p["armor"], trade))
            p["armor"] = arg
            self.npc_say(mob, "Thy %s fits thee perfectly." % arg)
        elif kind == "potion":
            p["potions"] += 1
            self.npc_say(mob, "One healing potion. Drink it with P.")
        elif kind == "cure":
            p["poison"] = False
            self.npc_say(mob, "The poison is gone from thy blood.")
        elif kind in ("heal", "room"):
            p["hp"] = p["maxhp"]
            self.npc_say(mob, "Thy wounds are healed." if kind == "heal" else
                         "Thou sleepest soundly, and wakest refreshed.")
            if kind == "room":
                self.turn += 100
        elif kind == "food":
            p["food"] += 50
            self.npc_say(mob, "Fifty meals of rations. Don't eat them all at "
                         "once!")
        elif kind == "ale":
            t = self.world["towns"][self.area.key[1]] \
                if self.area.kind == "town" else None
            here = (t["x"], t["y"]) if t else self.world["castle"]
            self.npc_say(mob, "Cheers! Here's what I hear: " +
                         random.choice(town_rumours(self.world, here)))
        self.render_chrome()

    # ── Lord Canadian ──

    def lord_greet(self, mob):
        p = self.p
        self.say("You kneel before Lord Canadian.", "info")
        for di in list(self.held):
            d = self.world["dungeons"][di]
            self.held.remove(di)
            self.returned.add(di)
            gold, xp = 150 * d["tier"], 100 * d["tier"]
            p["gold"] += gold
            p["xp"] += xp
            self.npc_say(mob, "Thou hast recovered %s! Canada... er, %s "
                         "thanks thee. Take this reward of %d gold." % (
                             d["artifact"], self.world["realm"], gold),
                         )
            self.say("(+%d xp, +%d gold)" % (xp, gold), "good")
            self.sound.play("quest")
        raised = False
        while p["level"] < MAX_LEVEL and p["xp"] >= xp_needed(p["level"]):
            p["level"] += 1
            gain = random.randint(8, 12)
            p["maxhp"] += gain
            p["str"] += random.randint(1, 2)
            p["dex"] += random.randint(1, 2)
            raised = True
            self.say("Thou art now level %d! (+%d max HP)" % (p["level"],
                                                              gain), "quest")
        if raised:
            self.root.after(300, self.sound.play, "level")
        if p["hp"] < p["maxhp"] or p["poison"]:
            p["hp"] = p["maxhp"]
            p["poison"] = False
            self.say("Lord Canadian lays his hands upon thee. Thy wounds "
                     "are healed.", "good")
        if "moosedain_dead" in self.flags and "won" not in self.flags:
            self.flags.add("won")
            self.npc_say(mob, "Moosedain is defeated! %s is saved! I "
                         "declare a holiday, with fireworks and pancakes. "
                         "And sorry it took so long to thank thee properly."
                         % self.world["realm"])
            self.overlay = "won"
            self.root.after(300, self.sound.play, "quest")
            self.save()
            return
        self.npc_say(mob, "Welcome, %s! How may I help thee, eh? (Ask me "
                     "about thy QUEST.)" % p["name"])
        self.save()

    def current_quest(self):
        for di in self.world["quests"]:
            if di not in self.returned:
                return di
        return None

    def lord_reply(self, w):
        p, world = self.p, self.world
        k = w.split()[0][:4]
        castle = world["castle"]
        if k == "name":
            return "I am Lord Canadian, ruler of %s. Sorry, I should have " \
                   "introduced myself sooner." % world["realm"]
        if k == "job":
            return "I rule this fair and chilly land. Mostly I apologise " \
                   "to people. Thou couldst help me with a QUEST."
        if k in ("ques", "miss", "task"):
            di = self.current_quest()
            if di is not None:
                d = world["dungeons"][di]
                held = " Thou hast it already, it seems: bring it here!" \
                    if di in self.held else ""
                n = len(self.returned)
                return ("%s relics were stolen by the minions of MOOSEDAIN; "
                        "%d of 4 are home again. %s has carried off %s to "
                        "%s, %s of my castle. Recover it, I beg thee!%s" % (
                            "Four", n, d["boss"], d["artifact"], d["name"],
                            where(castle, (d["x"], d["y"])), held))
            lair = world["dungeons"][5]
            spot = where(castle, (lair["x"], lair["y"]))
            if "final_quest" not in self.flags:
                self.flags.add("final_quest")
                if WEAPONS[p["weapon"]].price < WEAPONS["Maple Blade"].price:
                    p["weapon"] = "Maple Blade"
                self.sound.play("quest")
                self.save()
                return ("All four relics are home! From their power I have "
                        "forged the MAPLE BLADE: take it, for only it can "
                        "harm Moosedain. His lair lies %s. The ice that "
                        "sealed it has melted. Go, and end his wickedness!"
                        % spot)
            return "Moosedain's lair lies %s. Only the Maple Blade can " \
                   "harm him. Go!" % spot
        if k in ("moos", "evil", "enem"):
            return "Moosedain the Wicked, a sorcerer with the head of a " \
                   "moose and the manners of a goose. He sends his minions " \
                   "to plunder my realm. Only the MAPLE BLADE can harm him."
        if k == "mapl":
            return "The Maple Blade can be forged only from the power of " \
                   "the four stolen relics. Ask me about thy QUEST."
        if k in ("heal", "help"):
            return "I have healed thee. Always happy to help, eh?"
        if k in ("leve", "expe", "trai"):
            if p["level"] >= MAX_LEVEL:
                return "Thou art as mighty as any hero can be!"
            return "Return when thou hast gained experience and I shall " \
                   "raise thy level. Thou needest %d more experience." % (
                       xp_needed(p["level"]) - p["xp"])
        if k in ("cana", world["realm"].lower()[:4]):
            return "True north, strong and... well, chilly."
        if k == "syru":
            return "Never trust a man with no syrup on his pancakes."
        if k == "sorr":
            return "No, I'm sorry."
        if k == "hock":
            return "The royal team hasn't won the cup in years. Sorry."
        if k == "brit":
            return "Lord who? Some fellow across the sea, I believe. Never " \
                   "heard of him. He sounds very sure of himself."
        return None

    # ── Drawing ──

    def layout(self):
        """(Re)build the grid of canvas items to fit the canvas."""
        if not hasattr(self, "area"):
            return
        c = self.canvas
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.shown = [(None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        """True if nothing opaque lies strictly between the two squares."""
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r2 = LIGHT_RADIUS ** 2 if a.dark else None
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis

    def render(self):
        if not self.cells:
            return
        c, a = self.canvas, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        mobs = {(m.x, m.y): m for m in a.mobs}
        x0, y0 = px - cols // 2, py - rows // 2
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    if (x, y) in vis:
                        base = a.grid[y][x]
                        m = mobs.get((x, y))
                        if m:
                            top = m.tile
                    elif a.dark and a.seen[y * a.w + x]:
                        base = "~" + a.grid[y][x]
                elif a.edge:
                    base = a.edge
                if x == px and y == py:
                    top = "avatar"
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                bid, tid = self.cells[idx]
                if base != old[0]:
                    if base is None:
                        c.itemconfig(bid, state="hidden")
                    elif base[0] == "~":
                        c.itemconfig(bid, image=self.dimg[base[1:]],
                                     state="normal")
                    else:
                        c.itemconfig(bid, image=self.img[base],
                                     state="normal")
                if top != old[1]:
                    if top is None:
                        c.itemconfig(tid, state="hidden")
                    else:
                        c.itemconfig(tid, image=self.img[top], state="normal")
        c.delete("overlay")
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay == "won":
            self.draw_text_box(
                "VICTORY!\n\nMoosedain the Wicked is no more, and %s is "
                "saved.\n\nLord Canadian has declared a national holiday,\n"
                "and apologises for any inconvenience.\n\nYou finished at "
                "level %d after %d turns.\n\nPress N for a new world, or "
                "Escape to keep wandering." % (
                    self.world["realm"], self.p["level"], self.turn),
                ACCENT)
        self.render_chrome()

    def flash(self, x, y, tile="hit"):
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if not (0 <= i < cols and 0 <= j < rows):
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(160, hide)

    def draw_text_box(self, text, color=INK):
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        t = c.create_text(W / 2, H / 2, text=text, fill=color, font=MONO,
                          justify="left", tags="overlay")
        x0, y0, x1, y1 = c.bbox(t)
        r = c.create_rectangle(x0 - 20, y0 - 16, x1 + 20, y1 + 16,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        c.tag_raise(t, r)

    def draw_map(self):
        c, a = self.canvas, self.world_area
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(WORLD_H):
            row = []
            for x in range(WORLD_W):
                if not a.seen[y * WORLD_W + x]:
                    row.append("#000000")
                else:
                    t = a.grid[y][x]
                    row.append(SITE_COLORS.get(t) or self.avg[t])
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=WORLD_W, height=WORLD_H)
        img.put(" ".join(rows))
        z = max(1, int(min(W, H - 40) * 0.9) // WORLD_W)
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - WORLD_W * z) / 2, (H - WORLD_H * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        px, py = self.pos if self.area.kind == "world" else self.world_pos
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=MONO, tags="overlay",
                      text="Map of %s   (white: castle, red: towns, orange: "
                      "dungeons; any key closes)" % self.world["realm"])

    def render_chrome(self):
        p = self.p
        self.status.config(text=cap(self.area.name))
        self.turns.config(text="Turn %d" % self.turn)
        need = ("%d" % xp_needed(p["level"]) if p["level"] < MAX_LEVEL
                else "max")
        lines = [p["name"], "",
                 "Level   %d" % p["level"],
                 "HP      %d/%d" % (max(0, p["hp"]), p["maxhp"]),
                 "Str     %d" % p["str"],
                 "Dex     %d" % p["dex"],
                 "XP      %d/%s" % (p["xp"], need),
                 "Gold    %d" % p["gold"],
                 "Food    %d" % p["food"],
                 "Potions %d" % p["potions"], "",
                 "Weapon", "  %s (%d-%d)" % ((p["weapon"],) +
                                              WEAPONS[p["weapon"]].dmg),
                 "Armour", "  %s (AC %d)" % (p["armor"],
                                             ARMOURS[p["armor"]].ac), "",
                 "Relics  %d/4" % len(self.returned)]
        for di in self.world["quests"]:
            d = self.world["dungeons"][di]
            mark = ("+" if di in self.returned else
                    "*" if di in self.held else "-")
            lines.append(" %s %s" % (mark, d["artifact"][4:]))
        if "moosedain_dead" in self.flags:
            lines += ["", "Moosedain is slain!"]
        elif "final_quest" in self.flags:
            lines += ["", "Slay Moosedain!"]
        self.panel.config(text="\n".join(lines))
        cond = []
        if p["poison"]:
            cond.append("POISONED")
        if p["food"] <= 0:
            cond.append("STARVING")
        if 0 < p["hp"] <= p["maxhp"] // 4:
            cond.append("BADLY HURT")
        self.condition.config(text="\n".join(cond))
        self.btn["mute"].config(
            text="Sound: off" if self.sound.muted else "Sound: on")
        self.btn["music"].config(
            text="Music: off" if self.sound.music_off else "Music: on")
        self.sound.tune = self.area.kind

    # ── Commands ──

    def toggle_map(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "map" else "map"
        self.render()

    def show_help(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "help" else "help"
        self.render()

    def zoom(self, d):
        s = min(4, max(1, self.scale + d))
        if s != self.scale:
            self.scale = s
            self.scale_images()
            self.layout()

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.render_chrome()

    def toggle_music(self):
        self.sound.music_off = not self.sound.music_off
        self.sound.tick()
        self.render_chrome()

    def ask_new_game(self):
        if self.busy:
            return
        if "won" in self.flags or messagebox.askyesno(
                "New game", "Abandon this game and start again in a whole "
                "new world?", parent=self.root):
            self.new_game()


