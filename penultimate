def make_dungeon_level(world, di, level, flags):
    d = world["dungeons"][di]
    rng = random.Random("%s:dungeon:%d:%d" % (world["seed"], di, level))
    W, H = 44, 30
    g = blank(W, H, "dwall")
    rooms = []
    for _ in range(400):
        if len(rooms) >= 10:
            break
        rw, rh = rng.randint(4, 9), rng.randint(3, 6)
        rx, ry = rng.randint(1, W - rw - 1), rng.randint(1, H - rh - 1)
        if any(rx - 2 < x + w and x - 2 < rx + rw and
               ry - 2 < y + h and y - 2 < ry + rh for x, y, w, h in rooms):
            continue
        rooms.append((rx, ry, rw, rh))
    for rx, ry, rw, rh in rooms:
        fill(g, rx, ry, rx + rw - 1, ry + rh - 1, "dfloor")
    centers = [(rx + rw // 2, ry + rh // 2) for rx, ry, rw, rh in rooms]

    def corridor(a, b):
        (x1, y1), (x2, y2) = a, b
        if rng.random() < 0.5:
            fill(g, min(x1, x2), y1, max(x1, x2), y1, "dfloor")
            fill(g, x2, min(y1, y2), x2, max(y1, y2), "dfloor")
        else:
            fill(g, x1, min(y1, y2), x1, max(y1, y2), "dfloor")
            fill(g, min(x1, x2), y2, max(x1, x2), y2, "dfloor")

    order = sorted(range(len(rooms)), key=lambda i: centers[i])
    for a, b in zip(order, order[1:]):
        corridor(centers[a], centers[b])
    for _ in range(2):
        corridor(*rng.sample(centers, 2))

    up = centers[0]
    far = max(centers, key=lambda c: abs(c[0] - up[0]) + abs(c[1] - up[1]))
    g[up[1]][up[0]] = "stairs_up"
    last = level == d["levels"]
    area = Area("dungeon", ("dungeon", di, level), g,
                "%s, level %d" % (cap(d["name"]), level), None)
    area.dark = True
    area.start = up
    area.far = far
    if not last:
        g[far[1]][far[0]] = "stairs_down"
        area.down = far
    chests = rng.randint(2, 4)
    if last and d["quest"] is None and not d["lair"]:
        chests += 4
    for _ in range(chests):
        rx, ry, rw, rh = rng.choice(rooms)
        x, y = rng.randint(rx, rx + rw - 1), rng.randint(ry, ry + rh - 1)
        if g[y][x] == "dfloor" and (x, y) not in centers:
            if "chest:%d:%d:%d,%d" % (di, level, x, y) not in flags:
                g[y][x] = "chest"
    if last and d["boss"] and "boss:%d" % di not in flags:
        area.mobs.append(make_boss(d, di, far[0], far[1]))
    area.floor = [(x, y) for y in range(H) for x in range(W)
                  if g[y][x] == "dfloor"]
    return area


def dungeon_monster(d, level):
    eff = min(6, d["tier"] + level - 1)
    kinds = [k for k, t in MONSTERS.items()
             if t.habitat in ("dungeon", "both") and eff - 2 <= t.tier <= eff]
    return random.choice(kinds)


